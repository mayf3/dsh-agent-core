[
  {
    "name": "full-test",
    "command": [
      "cargo",
      "test",
      "--manifest-path",
      "packages/deployment-control-plane/Cargo.toml"
    ],
    "exit": 0
  },
  {
    "name": "fmt",
    "command": [
      "cargo",
      "fmt",
      "--manifest-path",
      "packages/deployment-control-plane/Cargo.toml",
      "--",
      "--check"
    ],
    "exit": 0
  },
  {
    "name": "clippy",
    "command": [
      "cargo",
      "clippy",
      "--manifest-path",
      "packages/deployment-control-plane/Cargo.toml",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "exit": 0
  },
  {
    "name": "release",
    "command": [
      "cargo",
      "build",
      "--manifest-path",
      "packages/deployment-control-plane/Cargo.toml",
      "--release"
    ],
    "exit": 0
  }
]