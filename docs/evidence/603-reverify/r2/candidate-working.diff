+const autoJob = {
+  id: 'runtime-auto-job', name: 'isolated auto reconciliation', agentId: 'agt_fixture', enabled: true,
+  scheduleRevision: 1, revisionActivatedAtMs: 1_000, createdAtMs: 1_000, updatedAtMs: 1_000,
