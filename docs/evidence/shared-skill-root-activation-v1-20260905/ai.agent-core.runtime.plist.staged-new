<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>AGENT_CORE_CREDENTIALS_FILE</key>
		<string>/usr/local/libexec/agent-core/config/agent-credentials.json</string>
		<key>BROKER_AUTH_ORIGIN</key>
		<string>http://127.0.0.1:4001</string>
		<key>DSH_AGENTS_HOME</key>
		<string>/Users/yanfenma/.agents</string>
		<key>DSH_AGENT_CHILD_GID</key>
		<string>20</string>
		<key>DSH_AGENT_CHILD_UID</key>
		<string>502</string>
		<key>DSH_AGENT_MODEL</key>
		<string>deepseek-v4-flash</string>
		<key>DSH_AGENT_PROVIDER</key>
		<string>oc-go</string>
		<key>DSH_AGENT_SPAWN_HELPER</key>
		<string>/usr/local/libexec/dsh-agent-spawn-helper</string>
		<key>DSH_AGENT_TURN_TIMEOUT</key>
		<string>900000</string>
		<key>DSH_HARNESS_ROOT</key>
		<string>/usr/local/libexec/agent-core/harness</string>
		<key>FEISHU_AUTO_MENTION_TRIGGER_SENDER</key>
		<string>false</string>
		<key>FEISHU_CREDS_PATH</key>
		<string>/Users/authsvc/.dsh/feishu-creds.json</string>
		<key>FEISHU_PROCESSING_REACTION_ENABLED</key>
		<string>true</string>
		<key>FEISHU_REPLY_RENDER_MODE</key>
		<string>card</string>
		<key>FEISHU_REQUIRE_MENTION_IN_GROUP</key>
		<string>false</string>
		<key>HOME</key>
		<string>/Users/authsvc</string>
		<key>NOTIFICATION_INGRESS_ENABLED</key>
		<string>1</string>
		<key>PATH</key>
		<string>/usr/local/libexec/agent-core/node-runtime/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>PRODUCT_API_ENABLED</key>
		<string>0</string>
	</dict>
	<key>GroupName</key>
	<string>authsvc</string>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>ai.agent-core.runtime</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/agent-core/node-runtime/bin/node</string>
		<string>/usr/local/libexec/agent-core/app/scripts/production-runtime.mjs</string>
		<string>--root</string>
		<string>/Users/authsvc/.agent-core</string>
		<string>--catchup</string>
		<string>0</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/authsvc/.agent-core/logs/runtime.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/authsvc/.agent-core/logs/runtime.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>UserName</key>
	<string>authsvc</string>
	<key>WorkingDirectory</key>
	<string>/usr/local/libexec/agent-core/app</string>
</dict>
</plist>
