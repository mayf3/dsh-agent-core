      "line_start": 356,
      "line_end": 370,
      "excerpt": "def launch_codex(config_path: pathlib.Path, config: dict[str, Any], state: dict[str, Any], root: pathlib.Path) -> str:\n    receipt = root / \"receipts\" / f\"codex-worker-{int(time.time())}.json\"\n    command = [\n        sys.executable,\n        str(root / \"bin\" / \"codex_continuation_worker.py\"),\n        \"--config\", str(config_path),\n        \"--receipt\", str(receipt),\n    ]\n    if state.get(\"CODEX_CONTINUATION_SESSION_ID\"):\n        command += [\"--session-id\", state[\"CODEX_CONTINUATION_SESSION_ID\"]]\n    log = (root / \"logs\" / \"worker-launch.log\").open(\"ab\", buffering=0)\n    proc = subprocess.Popen(\n        command,\n        stdin=subprocess.DEVNULL,\n        stdout=log,"
    }
