      "excerpt": "def build_command(codex_config: dict[str, Any], session_id: str | None) -> list[str]:\n    command = [\n        codex_config[\"binary\"], \"exec\",\n        \"--json\",\n        \"--approve-for-me\",\n        \"--model\", codex_config[\"model\"],\n        \"-c\", f'model_reasoning_effort=\"{codex_config[\"reasoning_effort\"]}\"',\n        \"-C\", codex_config[\"workspace\"],\n    ]\n    for path in codex_config.get(\"add_dirs\", []):"
