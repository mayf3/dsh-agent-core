      "line_start": 235,
      "line_end": 249,
      "excerpt": "    root=HOME/'.codex/sessions'\n    if not path.is_absolute() or '..' in path.parts or not path.is_relative_to(root) or target not in path.name:return {}\n    try:\n        if any(part.is_symlink() for part in (root,path,*path.parents) if part.is_relative_to(root)):return {}\n        if not path.resolve(strict=True).is_relative_to(root.resolve(strict=True)):return {}\n        before=os.lstat(path)\n        if path.is_symlink():return {}\n        fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW)\n        with os.fdopen(fd,'rb') as source:\n            opened=os.fstat(source.fileno())\n            if (opened.st_dev,opened.st_ino)!=(before.st_dev,before.st_ino):return {}\n            offset=max(0,opened.st_size-2*1024*1024)\n            source.seek(offset);lines=source.read(2*1024*1024).splitlines()\n            if offset:lines=lines[1:]\n        if any(part.is_symlink() for part in (root,path,*path.parents) if part.is_relative_to(root)):return {}"
    },
