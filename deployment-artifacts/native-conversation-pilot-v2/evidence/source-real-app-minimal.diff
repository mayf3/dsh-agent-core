+++ b/packages/product-api/src/conversation/auth.js
@@ -0,0 +1,55 @@
+import { parseBasicCredential } from '../../../notification-ingress/src/auth.js'
+import { lstatSync } from 'node:fs'
+import { dirname } from 'node:path'
+import { readPrivateJson } from '../../../agent-router/src/conversation/persistence.js'
+import { fault } from './protocol.js'
+export const RESOURCE = 'agent-core-mcp-conversation-v1'
+export const SCOPE = 'conversation.access'
+export function loadConversationConfig(path) {
+  try {
+    const directory=lstatSync(dirname(path))
+    if (!directory.isDirectory() || directory.isSymbolicLink() || directory.uid !== process.getuid?.() || (directory.mode & 0o077) !== 0) return null
+    return readPrivateJson(path, 1024 * 1024)
+  } catch { return null }
+}
+export function validateConfig(config) {
+  if (config?.enabled !== true) throw fault('NOT_PROVISIONED', 503)
+  let origin
+  try { origin = new URL(config.authServiceOrigin) } catch { throw fault('NOT_PROVISIONED', 503) }
+  if (origin.protocol !== 'https:' || origin.origin + '/' !== origin.href || !Number.isSafeInteger(config.retentionMs)
+    || config.retentionMs <= 0 || !Number.isSafeInteger(config.maxRecords) || config.maxRecords <= 0
+    || !Array.isArray(config.clients) || config.clients.length !== 1) throw fault('NOT_PROVISIONED', 503)
+  const client = config.clients[0]
+  for (const key of ['clientId','subject_id','communication_scope_id','principal_id']) {
+    if (typeof client[key] !== 'string' || !client[key] || client[key].length > 256) throw fault('NOT_PROVISIONED', 503)
+  }
+  if (!Array.isArray(client.operations) || client.operations.some(op => !['resolve','send','result'].includes(op))
+    || !Array.isArray(client.targets) || client.targets.length !== 1) throw fault('NOT_PROVISIONED', 503)
+  const target = client.targets[0]
+  for (const key of ['agent_id','principal_id','domain_id','binding_id','routing_version']) {
+    if (typeof target[key] !== 'string' || !target[key]) throw fault('NOT_PROVISIONED', 503)
+  }
+  return {...config,authServiceOrigin:origin.origin}
+}
+export async function authenticate({ authorization, config, operation, fetchImpl }) {
+  const credential = parseBasicCredential(authorization)
+  if (!credential) throw fault('INVALID_CREDENTIAL', 401)
+  let response, body
+  try {
+    response = await fetchImpl(config.authServiceOrigin + '/oauth/token', { method: 'POST', redirect:'error', headers: {
+      Authorization: authorization, 'Content-Type': 'application/x-www-form-urlencoded', Accept: 'application/json' },
+    body: new URLSearchParams({ grant_type: 'client_credentials', resource: RESOURCE, scope: SCOPE }).toString(), signal: AbortSignal.timeout(15000) })
+    body = await response.json()
+  } catch { throw fault('AUTH_INCONCLUSIVE', 503) }
+  if (!response.ok) {
+    if (response.status >= 400 && response.status < 500 && ['invalid_client','invalid_scope','invalid_grant','invalid_resource','invalid_target'].includes(body?.error)) throw fault('INVALID_CREDENTIAL', 401)
+    throw fault('AUTH_INCONCLUSIVE', 503)
+  }
+  if (response.status !== 200 || typeof body?.access_token !== 'string' || !body.access_token
+    || typeof body.token_type !== 'string' || body.token_type.toLowerCase() !== 'bearer'
+    || !Number.isSafeInteger(body.expires_in) || body.expires_in <= 0
+    || (body.resource !== undefined && body.resource !== RESOURCE) || (body.scope !== undefined && !body.scope.split(' ').includes(SCOPE))) throw fault('AUTH_INCONCLUSIVE', 503)
+  const principal = config.clients.find(client => client.clientId === credential.clientId)
+  if (!principal || !principal.operations.includes(operation)) throw fault('NO_ACCESS', 403)
+  return principal
+}
diff --git a/packages/product-api/src/conversation/http.js b/packages/product-api/src/conversation/http.js
--- /dev/null
+++ b/packages/product-api/src/conversation/http.js
@@ -0,0 +1,22 @@
+import { failure, fault } from './protocol.js'
+export function createConversationHandler({service} = {}) {
+  return async function handle(req,url) {
+    if (!url.pathname.startsWith('/v1/conversation/')) return null
+    if (req.socket?.remoteAddress && !['127.0.0.1','::1','::ffff:127.0.0.1'].includes(req.socket.remoteAddress)) return failure(fault('NO_ACCESS',403))
+    if (!service) return failure(fault('NOT_PROVISIONED',503))
+    const operation = url.pathname.slice('/v1/conversation/'.length)
+    if (req.method !== 'POST' || !['resolve','send','result'].includes(operation) || url.search) return failure(fault('NOT_SUPPORTED',405))
+    try {
+      const chunks=[]
+      let size=0
+      for await (const chunk of req) {
+        size+=chunk.length
+        if(size>1000000) throw fault('RESOURCE_LIMIT',413)
+        chunks.push(chunk)
+      }
+      let body
+      try {body=JSON.parse(new TextDecoder('utf-8',{fatal:true}).decode(Buffer.concat(chunks)))} catch {throw fault('INVALID_ARGUMENTS')}
+      return await service.invoke(operation,body,req.headers.authorization)
+    } catch(error) {return failure(error)}
+  }
+}
diff --git a/packages/product-api/src/conversation/native-proof.js b/packages/product-api/src/conversation/native-proof.js
--- /dev/null
+++ b/packages/product-api/src/conversation/native-proof.js
@@ -0,0 +1,39 @@
+/** Read only the original Router operation; never an admission/retry surface. */
+export function originalNativeProof(row,router) {
+  let proof
+  try {
+    proof=row.reconciliation_handle
+      ? router.getTurnReconciliation?.(row.reconciliation_handle)
+      : router.resolveCallerCorrelation?.({requestId:row.native_request_id})
+  } catch {
+    return {facts:{execution_status:'unknown',reply_status:'unknown',native_reconciliation_state:'unavailable',
+      error_class:'UPSTREAM_UNAVAILABLE'},read_failed:true}
+  }
+  if(!proof)return {facts:{}}
+  const snapshot=proof.snapshot
+  if(!snapshot){
+    if(['evicted','restart_lost'].includes(proof.state))return {facts:{execution_status:'unknown',reply_status:'unknown',
+      native_reconciliation_state:proof.state,error_class:'OUTCOME_UNKNOWN'}}
+    return {facts:{native_reconciliation_state:proof.state??'unknown'},pending:['pending','recovering'].includes(proof.state)}
+  }
+  if(snapshot.agentId!==row.agent_id||snapshot.sessionId!=='main'
+    ||(row.message_id!==null&&snapshot.messageId!==row.message_id)
+    ||(snapshot.callerCorrelation?.requestId!==undefined&&snapshot.callerCorrelation.requestId!==row.native_request_id)){
+    return {facts:{execution_status:'unknown',reply_status:'unknown',native_reconciliation_state:'coordinate_mismatch',
+      error_class:'RESULT_UNRECOVERABLE'}}
+  }
+  const outcome=snapshot.lateOutcome??snapshot.outcome??snapshot.initialOutcome??null
+  const facts={native_reconciliation_state:proof.state??'unknown',native_outcome:outcome,
+    native_termination_evidence:snapshot.terminationEvidence??null}
+  if(typeof snapshot.messageId==='string'&&snapshot.messageId){
+    facts.message_id=snapshot.messageId
+    facts.session_id='main'
+    facts.request_status='accepted'
+  }
+  if(outcome==='outcome_unknown')Object.assign(facts,{execution_status:'unknown',reply_status:'unknown',error_class:'OUTCOME_UNKNOWN'})
+  else if(outcome==='terminated_without_outcome')Object.assign(facts,{execution_status:'interrupted',reply_status:'unknown',error_class:'OUTCOME_UNKNOWN'})
+  else if(['failed','late_failed'].includes(outcome))Object.assign(facts,{execution_status:'failed',reply_status:'failed',error_class:'TARGET_RUN_FAILED'})
+  else if(outcome==='not_admitted')Object.assign(facts,{request_status:'not_executed',execution_status:'not_started',reply_status:'unavailable',error_class:'NOT_EXECUTED'})
+  else if(['completed','late_completed'].includes(outcome))facts.execution_status='completed'
+  return {facts,completed:['completed','late_completed'].includes(outcome),pending:['pending','recovering'].includes(proof.state)}
+}
