+  const ctx={get:key=>({agentDefinition:definition,workspaceBootstrap:bootstrap})[key],provide(){},effect:fn=>fn()}
+  const processFactory=opts=>({pid:12345,exit:undefined,state:'READY',spawn(){},ready:async()=>0,shutdown:async()=>{},
