"""Exact reviewer R1 sequence; required refusal assertion is not inverted."""
import unittest
from fixture import *
class ColdUnknown(unittest.TestCase):
 def test_parent_fsync_unknown_cold_changed_scene_cannot_close(self):
  f=Fixture(Candidate('candidate'))
  try:
   real=f.mod.os.fsync;dirs=[0];injected=[False]
   def sync(fd):
    if stat.S_ISDIR(os.fstat(fd).st_mode):
     dirs[0]+=1
     if dirs[0]==2:injected[0]=True;raise OSError('terminal parent fsync unknown')
    return real(fd)
   with patch.object(f.mod.os,'fsync',side_effect=sync):first=f.request(DISPOSE)
   self.assertTrue(injected[0]);self.assertFalse(first['ok']);self.assertTrue(f.auth_path.exists() and f.terminal_path.exists())
   before=(f.auth_path.read_bytes(),f.terminal_path.read_bytes());f.restart();self.assertFalse(f.execution._e32_durability);self.assertNotIn('disposal_terminal',f.request(STATUS)['data'])
   f.put(f.native_absences[0],b'foreign-before-first-successful-closure');f.journal_path.write_bytes(b'changed-before-first-successful-closure');fresh=f.mod._fresh;calls=[];syncs=[]
   def observe(e):calls.append('fresh');return fresh(e)
   with patch.object(f.mod,'_fresh',side_effect=observe),patch.object(f.mod.os,'fsync',side_effect=lambda fd:syncs.append(fd)):reply=f.request(DISPOSE)
   self.assertFalse(reply['ok'],reply);self.assertTrue(calls);self.assertEqual(syncs,[]);self.assertEqual(before,(f.auth_path.read_bytes(),f.terminal_path.read_bytes()))
  finally:f.close()
if __name__=='__main__':unittest.main()
