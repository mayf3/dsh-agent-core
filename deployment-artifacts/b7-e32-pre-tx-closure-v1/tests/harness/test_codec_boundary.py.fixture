"""Same real e32 DS, expected legitimate response acceptance; only codec changes."""
import ast,sys,unittest
from fixture import *
OLD='--old-client' in sys.argv
if OLD:sys.argv.remove('--old-client')
class PairedBoundary(unittest.TestCase):
 def test_actual_old_or_new_codec_accepts_the_same_fixed_terminal(self):
  c=Candidate('candidate')
  if OLD:c.client_tree=ast.parse((R/'baseline/ds_client.py').read_bytes())
  f=Fixture(c)
  try:
   reply=f.request(DISPOSE);self.assertTrue(reply['ok'],reply)
   paired=f.client_request(STATUS);self.assertTrue(paired['ok'],paired)
   self.assertEqual(set(paired['data']['disposal_terminal']),{'native_state','installed','authorization_sha256','execution_receipt_sha256'})
  finally:f.close()
if __name__=='__main__':unittest.main()
