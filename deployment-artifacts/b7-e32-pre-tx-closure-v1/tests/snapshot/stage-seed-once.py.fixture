class Refused(RuntimeError): pass

# Test-only injectable pin seam: defaults are the ORIGINAL production pins; no CLI or environment path sets these.
CHECKPOINT_SHA = '4e3218d2fa69568353f93e2960bbc774e20418ad890e992359481fe87d17d5b2'
