([\'/usr/local/bin/lark-cli\', \'api\', \'GET\', \'/open-apis/im/v1/messages/\' + message_id,\n        \'--as\', \'user\', \'--format\', \'json\', \'--params\', \'{"card_msg_content_type":"user_card_content"}\'], capture_output=True, timeout=120, user=502, group=20,\n        extra_groups=[], env={\'PATH\': \'/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin\', \'LC_ALL\': \'C\', \'HOME\': \'/Users/yanfenma\'})\n    require(run.returncode == 0 and len(run.stdout) <= LIMIT, \'FORMAL_EXACT_READ_FAILED\')\n    value = json.loads(run.stdout)\n    require(type(value.get(\'code\')) is int and value[\'code\'] == 0 and isinstance((value.get(\'data\') or {}).get(\'items\'), list)\n        and len(value[\'data\'][\'items\']) == 1 and value[\'data\'][\'items\'][0].get(\'message_id\') == message_id,\n        \'FORMAL_EXACT_MESSAGE_BINDING\')\n    return value\n\n# The fixed binding/identity/reader source is inserted only after Root supplies\n# the existing legitimate source facts and D freezes its reviewed module.\n# These are deliberately fail-closed integration seams, never model authority.\ndef project_key(workspace):\n    # Existing pinned DSH projectKey, including UTF-16 code-unit escaping.\n    require(isinstance(workspace, str) and workspace and os.path.isabs(workspace)\n        and os.path.normpath(workspace) == workspace, \'WORKSPACE_PATH\')\n    units = workspace.encode(\'utf-16-be\', errors=\'surrogatepass\')\n    readable, separator = \'\', False\n    for i in range(0, len(units), 2):\n        code = int.from_bytes(units[i:i+2], \'big\'); ch = chr(code)\n        if ch in \'/\\\\:\':\n            if not separator:\n                readable += \'-\'\n            separator = True\n        elif re.fullmatch(r\'[A-Za-z0-9._-]\', ch):\n            readable += ch; separator = False\n        else:\n            readable += \'~%04X\' % code; separator = False\n    return \'--\' + (readable.lstrip(\'-\') or \'root\')[:251] + \'--\'\n\n\ndef representative_workspace(agent, row):\n    # Exact production compose/bootstrap input, not caller configuration.\n    primary = read_json(\'/Users/authsvc/.agent-core/primary-workspaces.json\',\n        uid=505, gid=601, mode=0o600, limit=1048576)\n    require(type(primary) is dict, \'PRIMARY_WORKSPACES_SHAPE\')\n    workspace_id = row.get(\'workspace\')\n    if workspace_id is not None:\n        require(isinstance(workspace_id, str) and workspace_id.strip()\n            and len(workspace_id.encode(\'utf-16-be\')) // 2 <= 200\n            and not re.search(r\'[\\x00/\\\\ .]\', workspace_id), \'BINDING_WORKSPACE_ID\')\n        return os.path.normpath(\'/Users/authsvc/.agent-core/workspaces/\' + workspace_id)\n    explicit = primary.get(agent)\n    if explicit is not None:\n        require(isinstance(explicit, str) and os.path.isabs(explicit)\n            and \'\\x00\' not in explicit, \'PRIMARY_WORKSPACE_PATH\')\n        return os.path.normpath(explicit)\n    return \'/Users/authsvc/.agent-core/workspaces/\' + agent\n\n\ndef main_session(agent, workspace):\n    require(re.fullmatch(r\'agt_[A-Za-z0-9_-]+\', agent), \'MAIN_AGENT_SCOPE\')\n    home = \'/Users/authsvc/.agent-core/homes/\' + agent\n    # Existing authorized legacy owner and service homes coexist. Derive the\n    # journal custody from this representative\'s fixed home, never a request.\n    meta = os.lstat(home)\n    require(stat.S_ISDIR(meta.st_mode) and (meta.st_uid, meta.st_gid) in ((502, 20), (505, 601))\n            and not meta.st_mode & 0o022, \'FIXED_AGENT_HOME_CUSTODY\')\n    path = home + \'/sessions/\' + project_key(workspace) + \'/main/session.jsonl\'\n    raw = read_retained(path, uid=meta.st_uid, gid=meta.st_gid, limit=4096, prefix=True)\n    header = json.loads(raw.split(b\'\\n\', 1)[0])\n    require(type(header) is dict and header.get(\'type\') == \'session\' and header.get(\'id\') == \'main\', \'CANONICAL_MAIN_HEADER\')\n    return \'main\'\n\n\ndef binding_context(scope):\n    bindings = read_json(BINDINGS_PATH, uid=505, gid=601, mode=0o644, limit=1048576)\n    require(bindings.get(\'version\') == 1 and type(bindings.get(\'bindings\')) is dict, \'BINDING_STORE_SHAPE\')\n    representatives = []\n    for group in scope[\'groups\']:\n        candidates = []\n        for key, row in bindings[\'bindings\'].items():\n            if type(row) is not dict or row.get(\'activeAgentId\') not in group[\'agents\']:\n                continue\n            # Original bridge grammar: only an existing BASE chat can use\n            # messages-send. A :topic:/:sender: binding cannot be flattened.\n            if not isinstance(key, str) or not re.fullmatch(r\'feishu:oc_[A-Za-z0-9_-]+\', key):\n                continue\n            require(row.get(\'channelConversationId\') == key and isinstance(row.get(\'activeSessionId\'), str)\n                and row[\'activeSessionId\'] and len(row[\'activeSessionId\']) <= 256, \'BINDING_ROW\')\n            candidates.append((row[\'activeAgentId\'], key, row))\n        require(candidates, \'NO_EXISTING_BASE_CHAT_REPRESENTATIVE; thread binding needs original formal reply path\')\n        agent, key, row = sorted(candidates, key=lambda c: (c[0], c[1]))[0]\n        workspace = representative_workspace(agent, row)\n        representatives.append(dict(group_key=group[\'key\'], agent=agent,\n            channel_id=key[len(\'feishu:\'):], main_session_id=main_session(agent, workspace),\n            current_session_id=row[\'activeSessionId\'],\n            material_name=sha(group[\'key\'].encode()) + \'.material\'))\n    return representatives\n\n\nNATIVE_PROOF_SOURCE = \'"""B7 original-ingress evidence verification. Internal sealed caller API, no CLI.\\n\\nscope_context, identity and reader_policy MUST originate in the privileged\\noriginal TX/holder/accepted/scope chain. This module does not mint authority.\\nNo provider call, DS action, store mutation, retry, or replay occurs here.\\n"""\\nimport datetime\\nimport hashlib\\nimport json\\nimport os\\nimport re\\nimport stat\\nimport subprocess\\nimport time\\n\\nclass NativeProofError(Exception):\\n    def __init__(self, code):\\n        self.code = code\\n        super().__init__(code)\\n\\ndef _fail(code):\\n    raise NativeProofError(code)\\n\\ndef _sha(data):\\n    return hashlib.sha256(data).hexdigest()\\n\\ndef _canonical(value):\\n    return json.dumps(value, sort_keys=True, separators=(\\\',\\\', \\\':\\\'), ensure_ascii=False).encode(\\\'utf-8\\\')\\n\\ndef _identity(st):\\n    return (st.st_dev, st.st_ino, st.st_uid, st.st_gid, stat.S_IMODE(st.st_mode), st.st_nlink, st.st_size, st.st_mtime_ns, st.st_ctime_ns)\\n\\ndef _absolute(path):\\n    if not isinstance(path, str) or not path.startswith(\\\'/\\\') or \\\'\\\\x00\\\' in path or any(part in (\\\'.\\\',\\\'..\\\',\\\'\\\') for part in path.split(\\\'/\\\')[1:]):\\n        _fail(\\\'READER_PATH\\\')\\n    return path\\n\\ndef _open_bound(path):\\n    """All path components nofollow; retain and recheck ancestor descriptors."""\\n    parts = _absolute(path).split(\\\'/\\\')[1:]\\n    held = []\\n    try:\\n        fd = os.open(\\\'/\\\', os.O_RDONLY | os.O_DIRECTORY)\\n        held.append((fd, os.fstat(fd), None, None))\\n        for name in parts[:-1]:\\n            parent = fd\\n            fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)\\n            held.append((fd, os.fstat(fd), parent, name))\\n        leaf = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)\\n        held.append((leaf, os.fstat(leaf), fd, parts[-1]))\\n        return leaf, held\\n    except Exception:\\n        for entry in reversed(held):\\n            os.close(entry[0])\\n        raise\\n\\ndef _check_bound(held, code):\\n    for fd, before, parent, name in held:\\n        # Shared ancestors may gain unrelated children; bind their inode/custody,\\n        # while the held regular leaf retains the complete metadata identity.\\n        def identity(st):\\n            return (st.st_dev,st.st_ino,st.st_uid,st.st_gid,stat.S_IMODE(st.st_mode)) if stat.S_ISDIR(st.st_mode) else _identity(st)\\n        if identity(os.fstat(fd)) != identity(before):\\n            _fail(code)\\n        if parent is not None and identity(os.stat(name, dir_fd=parent, follow_symlinks=False)) != identity(before):\\n            _fail(code)\\n\\ndef _read_fd(fd, cap):\\n    os.lseek(fd, 0, os.SEEK_SET)\\n    chunks = []; size = 0\\n    while True:\\n        chunk = os.read(fd, min(65536, cap + 1 - size))\\n        if not chunk:\\n            break\\n        chunks.append(chunk); size += len(chunk)\\n        if size > cap:\\n            _fail(\\\'READER_SIZE\\\')\\n    os.lseek(fd, 0, os.SEEK_SET)\\n    return b\\\'\\\'.join(chunks)\\n\\ndef _check_pin(pin, executable=False):\\n    fd = None; held = []\\n    try:\\n        fd, held = _open_bound(pin[\\\'path\\\']); st = os.fstat(fd)\\n        if not stat.S_ISREG(st.st_mode) or st.st_uid != pin[\\\'uid\\\'] or st.st_mode & 0o022 or st.st_nlink != 1 or (executable and not st.st_mode & 0o111):\\n            _fail(\\\'CODE_PIN_MISMATCH\\\')\\n        if _sha(_read_fd(fd, 4*1024*1024)) != pin[\\\'sha256\\\']:\\n            _fail(\\\'CODE_PIN_MISMATCH\\\')\\n        _check_bound(held, \\\'CODE_PIN_MISMATCH\\\')\\n    except NativeProofError:\\n        raise\\n    except Exception:\\n        _fail(\\\'CODE_PIN_MISMATCH\\\')\\n    finally:\\n        for entry in reversed(held): os.close(entry[0])\\n\\ndef _run_reader(fd, policy, params):\\n    payload = dict(params, storeFd=fd, readerUid=policy[\\\'store_uid\\\'], readerGid=policy[\\\'store_gid\\\'])\\n    kwargs = {}\\n    if os.geteuid() == 0:\\n        # Existing privileged-reader discipline: validation child executes as\\n        # the native-store service UID, never as root. Not exercised in UID502 tests.\\n        def drop():\\n            os.setgroups([]); os.setgid(policy[\\\'store_gid\\\']); os.setuid(policy[\\\'store_uid\\\'])\\n        kwargs[\\\'preexec_fn\\\'] = drop\\n    elif os.geteuid() != policy[\\\'store_uid\\\'] or os.getegid() != policy[\\\'store_gid\\\']:\\n        _fail(\\\'READER_IDENTITY\\\')\\n    try:\\n        run = subprocess.run([policy[\\\'node_path\\\'], \\\'--input-type=module\\\', \\\'-e\\\', JS_READER], input=_canonical(payload), capture_output=True, pass_fds=(fd,), timeout=15, env={\\\'PATH\\\':\\\'/usr/bin:/bin\\\'}, **kwargs)\\n    except Exception:\\n        _fail(\\\'NATIVE_READER_UNKNOWN\\\')\\n    if run.returncode != 0 or len(run.stdout) > 2*1024*1024:\\n        _fail(\\\'NATIVE_READER_UNKNOWN\\\')\\n    try: result = json.loads(run.stdout)\\n    except Exception: _fail(\\\'NATIVE_READER_UNKNOWN\\\')\\n    if not isinstance(result, dict) or set(result) not in ({\\\'record\\\',\\\'faithful\\\'}, {\\\'error\\\'}):\\n        _fail(\\\'NATIVE_READER_UNKNOWN\\\')\\n    if \\\'error\\\' in result:\\n        if result[\\\'error\\\'] not in (\\\'V3_VALIDATION_FAILED\\\',\\\'NATIVE_INGRESS_ABSENT\\\',\\\'NATIVE_INGRESS_AMBIGUOUS\\\',\\\'RENDERER_UNSUPPORTED\\\',\\\'READER_IDENTITY\\\',\\\'FORMAL_CONVERSATION_BINDING\\\',\\\'CARD_PROFILE_UNSUPPORTED\\\'):\\n            _fail(\\\'NATIVE_READER_UNKNOWN\\\')\\n        _fail(result[\\\'error\\\'])\\n    return result\\n\\ndef _load_record(policy, params):\\n    held = []\\n    try:\\n        pins = policy[\\\'code_pins\\\']\\n        if not isinstance(pins, (tuple,list)) or not pins: _fail(\\\'READER_POLICY\\\')\\n        nodepin = dict(path=policy[\\\'node_path\\\'], sha256=policy[\\\'node_sha256\\\'], uid=policy[\\\'node_uid\\\'])\\n        for pin in [nodepin, *pins]: _check_pin(pin, executable=(pin is nodepin))\\n        fd, held = _open_bound(policy[\\\'store_path\\\']); st = os.fstat(fd)\\n        parent = held[-2][1]\\n        if not stat.S_ISREG(st.st_mode) or st.st_uid != policy[\\\'store_uid\\\'] or st.st_gid != policy[\\\'store_gid\\\'] or stat.S_IMODE(st.st_mode) != 0o600 or st.st_nlink != 1 or not 0 < st.st_size <= 16*1024*1024:\\n            _fail(\\\'STORE_CUSTODY\\\')\\n        if parent.st_uid not in (0, policy[\\\'store_uid\\\']) or parent.st_mode & 0o022:\\n            _fail(\\\'STORE_CUSTODY\\\')\\n        before = _sha(_read_fd(fd,16*1024*1024)); _check_bound(held, \\\'STORE_CHANGED\\\')\\n        result = _run_reader(fd, policy, params)\\n        if _sha(_read_fd(fd,16*1024*1024)) != before: _fail(\\\'STORE_CHANGED\\\')\\n        _check_bound(held, \\\'STORE_CHANGED\\\')\\n        for pin in [nodepin, *pins]: _check_pin(pin, executable=(pin is nodepin))\\n        return result, before\\n    except NativeProofError: raise\\n    except Exception: _fail(\\\'STORE_CUSTODY\\\')\\n    finally:\\n        for entry in reversed(held): os.close(entry[0])\\n\\ndef _string(value, code, limit=4096):\\n    if not isinstance(value,str) or not value or \\\'\\\\x00\\\' in value or len(value.encode(\\\'utf-8\\\')) > limit:\\n        _fail(code)\\n    return value\\n\\ndef _message(response, requested):\\n    if not isinstance(response,dict) or response.get(\\\'code\\\') != 0 or not isinstance(response.get(\\\'data\\\'),dict): _fail(\\\'FORMAL_MESSAGE_SHAPE\\\')\\n    items = response[\\\'data\\\'].get(\\\'items\\\')\\n    if not isinstance(items,list) or len(items) != 1 or not isinstance(items[0],dict): _fail(\\\'FORMAL_MESSAGE_SHAPE\\\')\\n    item = items[0]\\n    if \\\'message_type\\\' in item: _fail(\\\'FORMAL_MESSAGE_TYPE_CONFLICT\\\')\\n    if not isinstance(item.get(\\\'msg_type\\\'),str) or not item[\\\'msg_type\\\']: _fail(\\\'FORMAL_MESSAGE_SHAPE\\\')\\n    if item.get(\\\'message_id\\\') != requested: _fail(\\\'FORMAL_MESSAGE_ID\\\')\\n    if item.get(\\\'deleted\\\') is True or item.get(\\\'msg_type\\\') == \\\'deleted\\\': _fail(\\\'FORMAL_MESSAGE_SHAPE\\\')\\n    return item\\n\\ndef _body(item):\\n    try:\\n        raw = _string(item[\\\'body\\\'][\\\'content\\\'], \\\'FORMAL_BODY\\\', 2*1024*1024)\\n        obj = json.loads(raw)\\n    except NativeProofError: raise\\n    except Exception: _fail(\\\'FORMAL_BODY\\\')\\n   