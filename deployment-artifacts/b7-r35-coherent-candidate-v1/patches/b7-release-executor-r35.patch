n fields from the actual card.\\\\n   expectedCard.config={enable_forward_interaction:false,streaming_mode:false};\\\\n   expectedCard.body.elements[0].element_id=r.body.body.elements[0].element_id;\\\\n  }\\\\n  faithful=calls===1 && captured?.path?.message_id===incoming.message_id && captured?.data?.msg_type===\\\\\\\'interactive\\\\\\\' && captured?.data?.reply_in_thread===(conv.channel===\\\\\\\'thread\\\\\\\') && JSON.stringify(canonical(expectedCard))===JSON.stringify(canonical(r.body));\\\\n } else throw new Error(\\\\\\\'RENDERER_UNSUPPORTED\\\\\\\');\\\\n if(r.candidateText.length>3500)faithful=false;\\\\n process.stdout.write(JSON.stringify({record:matches[0],faithful}));\\\\n} catch(error) {\\\\n const code=[\\\\\\\'V3_VALIDATION_FAILED\\\\\\\',\\\\\\\'NATIVE_INGRESS_ABSENT\\\\\\\',\\\\\\\'NATIVE_INGRESS_AMBIGUOUS\\\\\\\',\\\\\\\'RENDERER_UNSUPPORTED\\\\\\\',\\\\\\\'READER_IDENTITY\\\\\\\',\\\\\\\'FORMAL_CONVERSATION_BINDING\\\\\\\',\\\\\\\'CARD_PROFILE_UNSUPPORTED\\\\\\\'].includes(error.message)?error.message:\\\\\\\'V3_VALIDATION_FAILED\\\\\\\';\\\\n process.stdout.write(JSON.stringify({error:code}));\\\\n}\\\\n\\\'\\n\'\nNATIVE_PROOF_SOURCE_SHA256 = \'8efb0267081c885db5b528a27df7474f6e36dd303dea1abb791052b9ce0c388c\'\nREADER_POLICY = {\'store_path\': \'/Users/authsvc/.agent-core/control/turn-recovery-v3.json\', \'store_uid\': 505, \'store_gid\': 601, \'node_path\': \'/usr/local/libexec/agent-core/node-runtime/bin/node\', \'node_sha256\': \'c6c9bfa8eb5d0c6799e1fd7e246f5c6036d4863b5d3173625f37d952576ca93b\', \'node_uid\': 0, \'code_pins\': [{\'path\': \'/usr/local/libexec/agent-core/app/packages/agent-router/src/reconciliation/durable-file.js\', \'sha256\': \'44120e2bc94c7b6941029ecf08eadde49dec4356bb7e9fb71d64849699fd5d26\', \'uid\': 505}, {\'path\': \'/usr/local/libexec/agent-core/app/packages/agent-router/src/reconciliation/capacity.js\', \'sha256\': \'237afe154801a0900209e68ddae47f1d7e0ca531594729209f16f687c73bb8b0\', \'uid\': 505}, {\'path\': \'/usr/local/libexec/agent-core/app/packages/agent-router/src/reconciliation/ingress-correlation.js\', \'sha256\': \'ac33ff2964f8a434dcc931e1b16e56cd783c0b9c6a284f55207457d28fea53ca\', \'uid\': 505}, {\'path\': \'/usr/local/libexec/agent-core/app/packages/agent-router/src/reconciliation/admin-abandonment.js\', \'sha256\': \'83d356f7d29c8ec542ec22672a02262cdfa795471271575a81729d7c9229a46f\', \'uid\': 505}, {\'path\': \'/usr/local/libexec/agent-core/app/node_modules/@larksuite/channel/dist/index.mjs\', \'sha256\': \'5cc175d7c2088b6e532f9cd153dac3b6e339d57204182e9965fddb03f8d7f63a\', \'uid\': 505}, {\'path\': \'/usr/local/libexec/agent-core/app/packages/feishu-connector/src/core.js\', \'sha256\': \'57e7869a6645777f4272479237e8afc90a868a8be28a381b5c3a5f711fe70158\', \'uid\': 505}, {\'path\': \'/usr/local/libexec/agent-core/app/packages/feishu-connector/src/reply-card.js\', \'sha256\': \'52c8b3d134b5d31a8a7b553a6f114472b21f49a254786e845967ceb61b89192c\', \'uid\': 505}, {\'path\': \'/usr/local/libexec/agent-core/app/packages/feishu-connector/src/reply-display.js\', \'sha256\': \'b0556246d3640446fc060938e496a30e985f311ac4b5522d565d660360601e21\', \'uid\': 505}, {\'path\': \'/usr/local/libexec/agent-core/app/packages/feishu-connector/src/index.js\', \'sha256\': \'3de9f3e4141ca17c1ea24b300c232eda68105b27e13e80b57939bf74af5d66a2\', \'uid\': 505}, {\'path\': \'/usr/local/libexec/agent-core/app/packages/agent-router/src/ingress-authenticated.js\', \'sha256\': \'17dcedddf0b15c644e61c523e72619e5e93584d23c0e4cecd8e88320d5d4f95e\', \'uid\': 505}, {\'path\': \'/usr/local/libexec/agent-core/app/packages/agent-router/src/channel-conversation.js\', \'sha256\': \'18e787bc1950077e8eac811a212925cb7ab6cbd0b90167c655b5903c09d33c25\', \'uid\': 505}, {\'path\': \'/usr/local/libexec/agent-core/app/packages/agent-router/src/ingress-delivery.js\', \'sha256\': \'1fe2e96144c2efa00c15be039a4f19a91449b6dfebd323cc9b767265098cf77b\', \'uid\': 505}]}\nTRUSTED_IDENTITY = {\'appId\': \'cli_a9d7abdf05385cd3\', \'botOpenId\': \'ou_1e1d5284ff846084bb78fce0aa11c083\'}\n\ndef native_proof(context, witness, material_bytes):\n    # D is a byte-pinned sealed literal, never a writable file import.\n    require(sha(NATIVE_PROOF_SOURCE.encode()) == NATIVE_PROOF_SOURCE_SHA256, \'PROOF_LITERAL_PIN\')\n    namespace = dict(__name__=\'b7_sealed_native_proof\')\n    exec(compile(NATIVE_PROOF_SOURCE, \'<sealed-native-proof>\', \'exec\'), namespace)\n    incoming_id, reply_id = witness.get(\'request_message_id\'), witness.get(\'pong_message_id\')\n    exchange = dict(incoming_message_id=incoming_id, reply_message_id=reply_id,\n        nonce=witness.get(\'nonce\'), incoming_response=exact_message(incoming_id),\n        reply_response=exact_message(reply_id))\n    require(exchange[\'incoming_response\'][\'data\'][\'items\'][0].get(\'chat_id\') == witness[\'channel_id\'],\n            \'PROTECTED_BINDING_CHAT\')\n    proof = namespace[\'load_verify\'](context, exchange, TRUSTED_IDENTITY,\n        reader_policy=READER_POLICY, material_bytes=material_bytes)\n    # These are the exact formal IDs already checked by the native verifier.\n    return dict(proof, incomingMessageId=incoming_id, replyMessageId=reply_id)\n\n\ndef proof_facts(auth, driven, op, tx, sequence, stage, group_key=None, source=None):\n    require(op in (auth.get(\'inScopeOperations\') or []), \'OP_OUT_OF_SCOPE\')\n    require(type(sequence) is int and sequence >= 0, \'SEQUENCE_SHAPE\')\n    status = current_status(op, tx, sequence)\n    native, scope = native_scope(driven, tx)\n    if stage == \'context\':\n        require(group_key is None, \'CONTEXT_GROUP\')\n        representatives = binding_context(scope)\n        initial_facts = loaded_health(auth)\n        require(current_status(op, tx, sequence) == status, \'STATUS_CHANGED_DURING_CONTEXT\')\n        return dict(kind=\'B7_CONTEXT_V1\', operationId=op, txId=tx, sequence=sequence,\n            holderNonce=native[\'outer\'][\'nonce\'], scope=scope, representatives=representatives,\n            **initial_facts)\n    answers, answers_sha, answers_path = runtime_answers(op, tx)\n    representatives = binding_context(scope)\n    witnesses = witness_set(answers, scope, op, tx, representatives)\n    # Reuse the original act\'s root-derived initial freshness cutoff after it\n    # exists; never replace it by a successor timestamp or caller assertion.\n    cutoff = stamp_ns(native.get(\'updatedAt\'))\n    act_path = MIGRATION + \'/b7-delegation-act.json\'\n    if stage not in (\'bind\', \'place\'):\n        act = read_json(act_path, mode=0o600)\n        require(act.get(\'kind\') == \'B7_DELEGATED_ACT_RECEIPT_V1\'\n            and act.get(\'approvalRef\') == \'OWNER-B7-RELEASE-20261016-01\'\n            and act.get(\'operationId\') == op and act.get(\'txId\') == tx\n            and act.get(\'holderNonce\') == native[\'outer\'][\'nonce\']\n            and act.get(\'serverSha256\') == auth[\'artifacts\'][\'deployment_system.py\']\n            and act.get(\'clientSha256\') == auth[\'artifacts\'][\'ds_client.py\']\n            and act.get(\'clauseSha256\') == auth.get(\'delegationClauseSha256\')\n            and act.get(\'inScopeOperations\') == auth.get(\'inScopeOperations\')\n            and act.get(\'manifestSha256\') == (auth.get(\'frozen_candidate\') or {}).get(\'packet_manifest_sha256\')\n            and act.get(\'gates\', {}).get(\'answersSha256\') == answers_sha, \'CURRENT_ACT_IDENTITY\')\n        initial = act.get(\'gates\', {}).get(\'nativeContext\') or {}\n        require(initial.get(\'scope\') == scope and initial.get(\'holderNonce\') == native[\'outer\'][\'nonce\']\n            and type(initial.get(\'txUpdatedAtNs\')) is int, \'CURRENT_ACT_NATIVE_CONTEXT\')\n        cutoff = initial[\'txUpdatedAtNs\']\n    context = dict(operationId=op, txId=tx, holderNonce=native[\'outer\'][\'nonce\'],\n        txUpdatedAtNs=cutoff, scope=scope, mainSessions={r[\'agent\']: r[\'main_session_id\'] for r in representatives})\n    proofs, materials, total = [], [], 0\n    for w in witnesses:\n        expected_source = DRIVEN_ROOT + \'/delegations/\' + op + \'/\' + tx + \'/\' + sha(w[\'group_key\'].encode()) + \'/\' + w[\'material_name\']\n        require(w.get(\'source_path\') == expected_source, \'FIXED_SOURCE_SCOPE\')\n        path = expected_source if stage == \'place\' else MIGRATION + \'/owner-materials-\' + tx + \'/\' + w[\'material_name\']\n        raw = read_retained(path, uid=502 if stage == \'place\' else 0,\n            gid=20 if stage == \'place\' else 0, mode=None if stage == \'place\' else 0o600)\n        total += len(raw)\n        require(total <= 22 * 1024 * 1024, \'ORIGINAL_TOTAL_MATERIAL_SIZE\')\n        require(sha(raw) == w[\'material_sha256\'], \'MATERIAL_ACTUAL_DIGEST\')\n        proof = native_proof(context, w, raw)\n        require(proof[\'agentId\'] == w[\'agent\'] and proof[\'groupKey\'] == w[\'group_key\']\n            and proof[\'sessionId\'] == w[\'current_session_id\']\n            and proof[\'materialSha256\'] == w[\'material_sha256\'], \'NATIVE_WITNESS_BINDING\')\n        proofs.append(proof)\n        materials.append(dict(groupKey=w[\'group_key\'], agent=w[\'agent\'], materialName=w[\'material_name\'], materialSha256=sha(raw)))\n    if stage == \'place\':\n        selected = [w for w in witnesses if w[\'source_path\'] == source]\n        require(len(selected) == 1, \'PLACEMENT_FIXED_WITNESS_SOURCE\')\n        return dict(operationId=op, txId=tx, materialName=selected[0][\'material_name\'], materialSha256=selected[0][\'material_sha256\'])\n    mdir = MIGRATION + \'/owner-materials-\' + tx\n    expected_placed = {(m[\'materialName\'], m[\'materialSha256\']) for m in materials}\n    placed = set()\n    for name in os.listdir(mdir):\n        require(re.fullmatch(r\'[A-Za-z0-9_-][A-Za-z0-9_.-]{0,80}\', name), \'PLACED_FOREIGN_NAME\')\n        placed.add((name, sha(read_retained(mdir + \'/\' + name, uid=0, gid=0, mode=0o600))))\n    require(placed == expected_placed, \'PLACED_SET_MISMATCH\')\n    if stage not in (\'bind\', \'place\'):\n        require(act[\'gates\'][\'materials\'] == materials, \'CURRENT_ACT_MATERIALS\')\n        # Fresh store snapshots and proof time may advance, but this same ACT\n        # cannot silently switch native executions, messages, or output proof.\n        def core(proof):\n            return {key: value for key, value in proof.items() if key not in (\'proofAtNs\', \'storeSha256\')}\n        retained = act[\'gates\'].get(\'native_proof\')\n        require(isinstance(retained, list) and len(retained) == len(proofs)\n            and [core(p) for p in retained] == [core(p) for p in proofs], \'CURRENT_ACT_NATIVE_PROOF\')\n    facts = loaded_health(auth)\n    require(stage in (\'bind\', \'commit\', \'witnessed\', \'confirm\'), \'TERMINAL_STAGE\')\n    require(group_key is None if stage != \'witnessed\' else group_key in {w[\'group_key\'] for w in witnesses}, \'TERMINAL_GROUP\')\n    # Reread STATUS after external verification, immediately before returning\n    # a fact set to the shell\'s durable receipt and terminal caller.\n    require(current_status(op, tx, sequence) == status, \'STATUS_CHANGED_DURING_GATES\')\n    facts.update(operationId=op, txId=tx, stage=stage, sequence=sequence, groupKey=group_key,\n        status=dict(phase=\'RUNNING\', active=True, attempt=1, input_sequence=sequence,\n            input_pending=False, reason=\'EXECUTION_INTENT\'),\n        nativeContext=context, native_proof=proofs, materials=materials,\n        answersSha256=answers_sha, verifiedAtNs=time.time_ns())\n    return facts\n\n\ndef actor_start_digest(path, op, tx, staged):\n    raw = read_retained(path, uid=0, gid=0, mode=0o644, limit=65536, tail=True)\n    row = json.loads(raw)\n    require(row.get(\'approval_ref\') == \'OWNER-B7-RELEASE-20261016-01\'\n        and row.get(\'operation\') == \'bind-act\' and row.get(\'outcome\') == \'STARTED\'\n        and row.get(\'detail\') == \'op=bind-act args=\' + op + \'|\' + tx + \'|\' + staged,\n        \'ACTOR_STARTED_CURRENT_INVOCATION\')\n    return sha(raw)\n\n\ndef write_act(auth, facts, actor_row_sha, actor_sha):\n    """Original ACT keys and recorder protocol; extra gate facts are retained.\n    O_EXCL never replaces a retained ACT. Any ambiguous write remains UNKNOWN.\n    """\n    native = facts[\'nativeContext\']\n    act = dict(kind=\'B7_DELEGATED_ACT_RECEIPT_V1\', approvalRef=\'OWNER-B7-RELEASE-20261016-01\',\n        operationId=facts[\'operationId\'], txId=facts[\'txId\'], holderNonce=native[\'holderNonce\'],\n        actorExecutorSha256=actor_sha, actorReceiptDigest=actor_row_sha,\n        serverSha256=auth[\'artifacts\'][\'deployment_system.py\'], clientSha256=auth[\'artifacts\'][\'ds_client.py\'],\n        manifestSha256=(auth.get(\'frozen_candidate\') or {}).get(\'packet_manifest_sha256\'),\n        clauseSha256=auth.get(\'delegationClauseSha256\'), inScopeOperations=auth.get(\'inScopeOperations\') or [],\n        gates=dict(identity_verified=True, health=\'deliverReady\',\n            pongMessageId=facts[\'native_proof\'][0][\'replyMessageId\'],\n            answersSha256=facts[\'answersSha256\'], materials=facts[\'materials\'],\n            at=datetime.datetime.now(datetime.timezone.utc).isoformat(),\n            nativeContext=native, native_proof=facts[\'native_proof\']), actBoundAtNs=time.time_ns())\n    raw = compact(act).encode()\n    require(len(raw) <= 65536, \'ORIGINAL_ACT_SIZE_BOUND\')\n    held, links = [], []\n    parent = os.open(\'/\', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)\n    held.append(parent)\n    for part in MIGRATION.split(\'/\')[1:]:\n        child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=parent)\n        held.append(child); links.append((parent, part, child)); parent = child\n        meta = os.fstat(parent)\n        require(meta.st_uid == 0 and not meta.st_mode & 0o022, \'ACT_ANCESTOR_CUSTODY\')\n    fd = None\n    try:\n        meta = os.fstat(parent)\n        require((meta.st_uid, meta.st_gid, stat.S_IMODE(meta.st_mode)) == (0, 0, 0o700), \'ACT_PARENT_CUSTODY\')\n        fd = os.open(\'b7-delegation-act.json\', os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=parent)\n        st = os.fstat(fd)\n        require(stat.S_ISREG(st.st_mode) and (st.st_uid, st.st_gid, stat.S_IMODE(st.st_mode), st.st_nlink) == (0, 0, 0o600, 1), \'ACT_CUSTODY\')\n        offset = 0\n        while offset < len(raw):\n            try:\n                n = os.write(fd, raw[offset:])\n            except InterruptedError:\n                continue\n            require(n > 0, \'ACT_INCOMPLETE_WRITE\'); offset += n\n        require(os.fstat(fd).st_size == len(raw) and os.pread(fd, len(raw), 0) == raw, \'ACT_WRITE_READBACK\')\n        for p, name, child in links:\n            entry, bound = os.stat(name, dir_fd=p, follow_symlinks=False), os.fstat(child)\n            require(stat.S_ISDIR(entry.st_mode) and (entry.st_dev, entry.st_ino) == (bound.st_dev, bound.st_ino), \'ACT_ANCESTOR_CHANGED\')\n        os.fsync(fd); os.fsync(parent)\n    except BaseException:\n        print(\'BIND_ACT_REFUSED_OR_UNKNOWN; preserve any ACT/effects, no automatic retry\', file=sys.stderr)\n        raise\n    finally:\n        if fd is not None:\n            os.close(fd)\n        for held_fd in reversed(held):\n            os.close(held_fd)\n    return act\n\n\ndef dispatch(driven, mode, arg1, arg2, arg3):\n    require(os.geteuid() == 0, \'ROOT_EXECUTOR_REQUIRED\')\n    auth = authority()\n    if mode == \'place\':\n        tx, source, name = arg1, arg2, arg3\n        prefix = DRIVEN_ROOT + \'/delegations/\'\n        require(source.startswith(prefix) and os.path.normpath(source) == source, \'FIXED_PLACEMENT_SOURCE\')\n        suffix = source[len(prefix):].split(\'/\')\n        require(len(suffix) == 4 and suffix[1] == tx and suffix[3] == name\n            and re.fullmatch(r\'[a-f0-9]{64}\', suffix[2]), \'FIXED_PLACEMENT_LAYOUT\')\n     