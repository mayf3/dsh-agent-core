-ROOT_BRIDGE_SOURCE = '"""Sealed executor-only wiring; no request-supplied authority/reader policy.\n\nBuilt mechanically into the restricted executor. This file is never imported\nfrom WB by root. Original ACT/recorder protocol and placement I/O remain intact.\n"""\nimport datetime\nimport hashlib\nimport json\nimport os\nimport re\nimport stat\nimport subprocess\nimport sys\nimport time\nfrom pathlib import Path\n\nSTATE = \'/private/var/db/agent-deploy-system\'\nAUTHORITY = STATE + \'/b7-v3-publication-authority.json\'\nAUTH_PIN = STATE + \'/b7-v3-publication-pin.json\'\nMIGRATION = \'/private/var/db/agent-core/authsvc-codex-migration\'\nDRIVEN_ROOT = \'/private/var/db/agent-deploy-system-driven\'\nCLIENT = \'/usr/local/libexec/agent-deploy-system/ds_client.py\'\nSERVER = \'/usr/local/libexec/agent-deploy-system/deployment_system.py\'\nNODE = \'/usr/local/libexec/agent-core/node-runtime/bin/node\'\nBINDINGS_PATH = \'/Users/authsvc/.agent-core/bindings/bindings.json\'\nLIMIT = 22020096\n\nclass Refused(ValueError):\n    pass\n\n\ndef require(ok, message):\n    if not ok:\n        raise Refused(message)\n\n\ndef sha(raw):\n    return hashlib.sha256(raw).hexdigest()\n\n\ndef compact(value):\n    return json.dumps(value, sort_keys=True, separators=(\',\', \':\'), ensure_ascii=True)\n\n\ndef read_retained(path, *, uid, gid, mode=None, limit=LIMIT, tail=False, prefix=False, interpreter=False):\n    """All ancestor links rejected, retained fd bytes and entry rechecked.\n\n    Root custody is mandatory for protected inputs; owner staging can supply\n    data, never code or policy. Retain failures and refuse, never repair modes.\n    """\n    require(isinstance(path, str) and os.path.isabs(path) and os.path.normpath(path) == path,\n            \'READ_PATH_FORM\')\n    fds, links, directory_paths = [], [], {}\n    def identity(s):\n        return (s.st_dev, s.st_ino, s.st_mode, s.st_uid, s.st_gid, s.st_nlink,\n                s.st_size, s.st_mtime_ns, s.st_ctime_ns)\n    try:\n        parent = os.open(\'/\', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)\n        fds.append(parent); directory_paths[parent] = \'/\'\n        for part in path.split(\'/\')[1:-1]:\n            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=parent)\n            directory_paths[child] = os.path.join(directory_paths[parent], part)\n            fds.append(child); links.append((parent, part, child)); parent = child\n        name = os.path.basename(path)\n        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK, dir_fd=parent)\n        fds.append(fd); before = os.fstat(fd)\n        require(stat.S_ISREG(before.st_mode) and before.st_nlink == 1\n                and before.st_uid == uid and (gid is None or before.st_gid == gid), \'READ_FILE_CUSTODY\')\n        require(not before.st_mode & 0o022 and (mode is None or stat.S_IMODE(before.st_mode) == mode), \'READ_FILE_MODE\')\n        require(0 <= before.st_size and (tail or prefix or before.st_size <= limit), \'READ_FILE_BOUND\')\n        if prefix:\n            raw = os.pread(fd, min(before.st_size, limit), 0)\n            require(len(raw) == min(before.st_size, limit), \'READ_HEADER_SIZE\')\n        elif tail:\n            # Current existing bounded receipt row only, no whole-log threshold.\n            size = min(before.st_size, limit + 1)\n            raw = os.pread(fd, size, before.st_size - size)\n            require(len(raw) == size and raw.endswith(b\'\\n\'), \'RECEIPT_PARTIAL_HISTORY_RETAINED\')\n            lines = raw[:-1].split(b\'\\n\')\n            require(before.st_size <= size or len(lines) >= 2, \'RECEIPT_CURRENT_ROW_BOUND\')\n            raw = lines[-1]\n            require(len(raw) <= limit, \'RECEIPT_CURRENT_ROW_BOUND\')\n        else:\n            chunks, count = [], 0\n            while True:\n                try:\n                    piece = os.read(fd, min(1048576, limit + 1 - count))\n                except InterruptedError:\n                    continue\n                if not piece:\n                    break\n                count += len(piece); require(count <= limit, \'READ_ACTUAL_BOUND\'); chunks.append(piece)\n            raw = b\'\'.join(chunks)\n            require(count == before.st_size, \'READ_SIZE_CHANGED\')\n        after = os.fstat(fd)\n        entry = os.stat(name, dir_fd=parent, follow_symlinks=False)\n        if prefix:\n            # Original session-listing permits live journal growth. Verify\n            # the SAME retained header bytes and custody; never scan its body.\n            def header_identity(meta):\n                return (meta.st_dev, meta.st_ino, meta.st_mode, meta.st_uid, meta.st_gid, meta.st_nlink)\n            require(header_identity(after) == header_identity(before)\n                and header_identity(entry) == header_identity(before)\n                and after.st_size >= before.st_size and entry.st_size >= before.st_size\n                and os.pread(fd, len(raw), 0) == raw, \'READ_HEADER_CHANGED\')\n        else:\n            require(identity(after) == identity(before), \'READ_FD_CHANGED\')\n            require(identity(entry) == identity(before), \'READ_ENTRY_CHANGED\')\n        for p, n, c in links:\n            held, entry = os.fstat(c), os.stat(n, dir_fd=p, follow_symlinks=False)\n            require(stat.S_ISDIR(entry.st_mode) and (held.st_dev, held.st_ino) == (entry.st_dev, entry.st_ino), \'READ_ANCESTOR_CHANGED\')\n            # Protected root inputs cannot inherit a writable parent. Owner\n            # staged files are separately checked as data and rehashed by IO.\n            if uid == 0:\n                if interpreter:\n                    # Original fixed Node reader profile: the root-owned\n                    # pinned leaf has known service-owned runtime parents.\n                    require(path == NODE and held.st_uid in (0, 505)\n                        and not held.st_mode & 0o022, \'NODE_ANCESTOR_CUSTODY\')\n                elif directory_paths[c] == STATE:\n                    # Original fixed STATE is retained root:admin 0770.\n                    # This exact ancestor exception never changes leaf custody.\n                    require((held.st_uid, held.st_gid, stat.S_IMODE(held.st_mode))\n                        == (0, 80, 0o770), \'READ_ANCESTOR_CUSTODY\')\n                else:\n                    require(held.st_uid == 0 and not held.st_mode & 0o022, \'READ_ANCESTOR_CUSTODY\')\n        return raw\n    finally:\n        for fd in reversed(fds):\n            os.close(fd)\n\n\ndef read_json(path, *, uid=0, gid=0, mode=None, limit=LIMIT):\n    return json.loads(read_retained(path, uid=uid, gid=gid, mode=mode, limit=limit))\n\n\ndef authority_files():\n    pin_raw = read_retained(AUTH_PIN, uid=0, gid=0)\n    pin = json.loads(pin_raw)\n    raw = read_retained(AUTHORITY, uid=0, gid=0)\n    require(pin.get(\'kind\') == \'DS_B7_V3_PAIR_PUBLICATION_PIN_V1\'\n            and pin.get(\'authorization_sha256\') == sha(raw), \'INDEPENDENT_AUTHORITY_PIN\')\n    auth = json.loads(raw)\n    require(auth.get(\'kind\') == \'DS_B7_V3_PAIR_PUBLICATION_AUTH_V1\', \'AUTHORITY_KIND\')\n    return auth, raw, pin_raw\n\n\ndef authority():\n    return authority_files()[0]\n\n\ndef authority_manifest():\n    auth = authority()\n    driven = auth.get(\'drivenScripts\') or {}\n    require(driven and \'owner-deploy-session.sh\' in driven, \'DRIVEN_MANIFEST_MISSING\')\n    return dict(authority=auth, driven=driven, drivenConfigs=auth.get(\'drivenConfigs\') or {})\n\n\ndef seal_authority_closure(driven, serialized_manifest):\n    """Copy only two protected raw files; exact capsule is data, never authority."""\n    auth, auth_raw, pin_raw = authority_files()\n    manifest = json.loads(serialized_manifest)\n    require(manifest == dict(authority=auth, driven=auth.get(\'drivenScripts\') or {},\n        drivenConfigs=auth.get(\'drivenConfigs\') or {}), \'AUTHORITY_CHANGED_DURING_PREPARE\')\n    require(driven.startswith(DRIVEN_ROOT + \'/inv-\') and os.path.normpath(driven) == driven\n        and \'/\' not in driven[len(DRIVEN_ROOT) + 1:], \'FIXED_DRIVEN_CLOSURE\')\n    expected = dict(manifest[\'driven\'], **manifest[\'drivenConfigs\'])\n    require(not {\'b7-v3-publication-authority.json\', \'b7-v3-publication-pin.json\',\n        \'CAPSULE-MANIFEST.json\'} & set(expected), \'CLOSURE_RESERVED_MEMBER\')\n    expected[\'b7-v3-publication-pin.json\'] = sha(pin_raw)\n    capsule = read_json(driven + \'/CAPSULE-MANIFEST.json\', uid=0, gid=0, mode=0o444)\n    require(capsule.get(\'kind\') == \'B7_V50_FREEZE_CAPSULE_V1\'\n        and capsule.get(\'members\') == expected, \'CAPSULE_EXACT_PROTECTED_MEMBERS\')\n    # All pre-existing flat copies were sealed by the original manifest loop;\n    # recheck every actual copy against the exact complete capsule before use.\n    for name, digest in expected.items():\n        require(re.fullmatch(r\'[A-Za-z0-9_.-]+\', name) and type(digest) is str\n            and re.fullmatch(r\'[a-f0-9]{64}\', digest), \'CAPSULE_MEMBER_SHAPE\')\n        if name != \'b7-v3-publication-pin.json\':\n            path = driven + \'/\' + name\n            require(sha(read_retained(path, uid=0, gid=0,\n                limit=os.lstat(path).st_size)) == digest, \'CAPSULE_COPIED_MEMBER_DIGEST\')\n    held = []\n    try:\n        fd = os.open(\'/\', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)\n        held.append((fd, None, None))\n        for part in driven.split(\'/\')[1:]:\n            parent = fd\n            fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)\n            held.append((fd, parent, part))\n            meta = os.fstat(fd)\n            require(meta.st_uid == 0 and not meta.st_mode & 0o022, \'CLOSURE_DIRECTORY_CUSTODY\')\n        meta = os.fstat(fd)\n        require(meta.st_gid == 0 and stat.S_IMODE(meta.st_mode) == 0o755, \'CLOSURE_DIRECTORY_MODE\')\n        for name, raw in [(\'b7-v3-publication-authority.json\', auth_raw),\n                          (\'b7-v3-publication-pin.json\', pin_raw)]:\n            out = os.open(name, os.O_CREAT | os.O_EXCL | os.O_RDWR | os.O_NOFOLLOW, 0o444, dir_fd=fd)\n            try:\n                os.fchmod(out, 0o444)\n                start = os.fstat(out)\n                require(stat.S_ISREG(start.st_mode) and start.st_uid == 0\n                    and start.st_gid == 0 and start.st_nlink == 1, \'CLOSURE_NEW_FILE_CUSTODY\')\n                offset = 0\n                while offset < len(raw):\n                    try: count = os.write(out, raw[offset:])\n                    except InterruptedError: continue\n                    require(count > 0, \'CLOSURE_WRITE_INCOMPLETE\')\n                    offset += count\n                os.fsync(out)\n                require(os.pread(out, len(raw) + 1, 0) == raw, \'CLOSURE_READBACK\')\n                entry, after = os.stat(name, dir_fd=fd, follow_symlinks=False), os.fstat(out)\n                require((entry.st_dev, entry.st_ino, entry.st_uid, entry.st_gid, entry.st_nlink,\n                    stat.S_IMODE(entry.st_mode), entry.st_size) ==\n                    (after.st_dev, after.st_ino, 0, 0, 1, 0o444, len(raw)), \'CLOSURE_ENTRY_CHANGED\')\n                os.fsync(fd)\n            finally:\n                os.close(out)\n        for child, parent, name in held:\n            if parent is not None:\n                meta, entry = os.fstat(child), os.stat(name, dir_fd=parent, follow_symlinks=False)\n                require((meta.st_dev, meta.st_ino) == (entry.st_dev, entry.st_ino)\n                    and stat.S_ISDIR(entry.st_mode) and meta.st_uid == 0\n                    and not meta.st_mode & 0o022, \'CLOSURE_DIRECTORY_CHANGED\')\n        require(read_retained(AUTHORITY, uid=0, gid=0) == auth_raw\n            and read_retained(AUTH_PIN, uid=0, gid=0) == pin_raw, \'AUTHORITY_CHANGED_DURING_COPY\')\n        require(sha(read_retained(driven + \'/b7-v3-publication-pin.json\', uid=0, gid=0,\n            mode=0o444)) == expected[\'b7-v3-publication-pin.json\'], \'CAPSULE_COPIED_PIN_DIGEST\')\n        return dict(kind=\'B7_AUTHORITY_CLOSURE_SEALED\', authorizationSha256=sha(auth_raw),\n            pinSha256=sha(pin_raw))\n    finally:\n        for fd, _, _ in reversed(held): os.close(fd)\n\n\ndef validate_status(value, op, tx, sequence=None):\n    require(type(value) is dict and value.get(\'schema\') == \'ds-b7-execution-v2\'\n        and value.get(\'action\') == \'DS_B7_EXECUTION_STATUS_V2\'\n        and value.get(\'operation_id\') == op and value.get(\'ok\') is True\n        and value.get(\'error\') is None and value.get(\'effect\') == \'READ_ONLY\'\n        and value.get(\'replay_allowed\') is False\n        and value.get(\'current_runtime_verified\') is False, \'STATUS_ENVELOPE\')\n    d = value.get(\'data\') or {}\n    require(d.get(\'phase\') == \'RUNNING\' and d.get(\'reason\') == \'EXECUTION_INTENT\'\n        and d.get(\'active\') is True and d.get(\'execution_enabled\') is True\n        and d.get(\'tx_id\') == tx and type(d.get(\'attempt\')) is int and d[\'attempt\'] == 1\n        and type(d.get(\'input_sequence\')) is int and d[\'input_sequence\'] >= 0\n        and d.get(\'input_pending\') is False, \'STATUS_CURRENT_ATTEMPT_TX\')\n    require(sequence is None or type(sequence) is int and sequence == d[\'input_sequence\'], \'STATUS_SEQUENCE\')\n    return d\n\n\ndef current_status(op, tx, sequence=None):\n    run = subprocess.run([\'/usr/bin/python3\', \'-I\', CLIENT, \'b7-status-r3\', op],\n        capture_output=True, timeout=60, user=502, group=20, extra_groups=[],\n        env={\'PATH\': \'/usr/bin:/bin\', \'LC_ALL\': \'C\'})\n    require(run.returncode == 0 and len(run.stdout) <= 1048576, \'STATUS_TRANSPORT\')\n    return validate_status(json.loads(run.stdout), op, tx, sequence)\n\n\ndef stamp_ns(value):\n    require(isinstance(value, str), \'NATIVE_TIMESTAMP_MISSING\')\n    stamp = datetime.datetime.fromisoformat(value.replace(\'Z\', \'+00:00\'))\n    require(stamp.tzinfo is not None, \'NATIVE_TIMESTAMP_ZONE\')\n    return int(stamp.timestamp() * 1000000000)\n\n\ndef validate_scope(scope, tx):\n    require(type(scope) is dict and scope.get(\'txId\') == tx, \'NATIVE_SCOPE_TX\')\n    groups = scope.get(\'groups\')\n    require(isinstance(groups, list) and 0 < len(groups) <= 1024, \'NATIVE_GROUPS\')\n    seen = set()\n    for group in groups:\n        require(type(group) is dict and re.fullmatch(r\'[a-f0-9]{64}\', str(group.get(\'routeSha256\', \'\')))\n            and group.get(\'provision\') in (\'existing\', \'normal\')\n            and group.get(\'key\') == group[\'routeSha256\'] + \':\' + group[\'provision\']\n            and group[\'key\'] not in seen and isinstance(group.get(\'agents\'), list)\n            and group[\'agents\'] and len(set(group[\'agents\'])) == len(group[\'agents\'])\n            and all(isinstance(a, str) and re.fullmatch(r\'[A-Za-z0-9_-]+\', a) for a in group[\'agents\']), \'NATIVE_GROUP_SHAPE\')\n        seen.add(group[\'key\'])\n    return scope\n\n\ndef native_scope(driven, tx):\n    native_raw = read_retained(MIGRATION + \'/migration-transaction.json\', uid=0, gid=0, mode=0o600)\n    native = json.loads(native_raw)\n    require(native.get(\'txId\') == tx and native.get(\'state\') == \'APPLIED_AWAITING_PONG\', \'NATIVE_TX_STATE\')\n    holder = native.get(\'outer\') or {}; binding = holder.get(\'binding\') or {}\n    require(holder.get(\'format\') == \'B7_GLOBAL_HOLDER_V1\' and holder.get(\'phase\') == \'SEALED\'\n        and re.fullmatch(r\'[a-f0-9]{32}\', str(holder.get(\'nonce\', \'\')))\n        and binding.get(\'txId\') == tx and binding.get(\'recoveryRoot\') == \'/var/db/agent-core/authsvc-codex-migration\'\n        and binding.get(\'trustedRoot\') == \'/usr/local/libexec/agent-core\', \'NATIVE_HOLDER\')\n    require(driven.startswith(DRIVEN_ROOT + \'/inv-\') and os.path.dirname(driven) == DRIVEN_ROOT, \'FIXED_DRIVEN_SCOPE\')\n    # prepare_driven has verified the entire copied tree against the protected\n    # authority-bound config. Recheck the exact executable dependencies on held\n    # root-custody descriptors before using the existing original producer.\n    repo = driven + \'/b7-install-r34/b7-wired-inputs/dsh-agent-core\'\n    producer = repo + \'/scripts/lib/deployment-reuse/canary-producer.mjs\'\n    producer_raw = read_retained(producer, uid=0, gid=0)\n    require(sha(producer_raw) == binding.get(\'canaryProducerSha256\'), \'NATIVE_PRODUCER_PIN\')\n    for dependency in (\'cohort-binding.mjs\', \'cohort-runtime.mjs\', \'cohort-artifacts.mjs\'):\n        read_retained(repo + \'/scripts/lib/deployment-reuse/\' + dependency, uid=0, gid=0)\n    require(sha(read_retained(NODE, uid=0, gid=0, mode=0o755, limit=4 * 1024 * 1024, interpreter=True)) == READER_POLICY[\'node_sha256\'], \'NATIVE_NODE_PIN\')\n    accepted = read_json(MIGRATION + \'/b7-accepted-\' + tx + \'.json\')\n    run = subprocess.run([NODE, producer, \'scope\', tx], input=compact(dict(transaction=native,\n        accepted=accepted, witnesses=[])).encode(), capture_output=True, timeout=60,\n        env={\'PATH\': \'/usr/bin:/bin\', \'LC_ALL\': \'C\'})\n    require(run.returncode == 0 and len(run.stdout) <= 4 * 1024 * 1024, \'NATIVE_SCOPE_PRODUCER\')\n    scope = validate_scope(json.loads(run.stdout), tx)\n    require(read_retained(MIGRATION + \'/migration-transaction.json\', uid=0, gid=0, mode=0o600) == native_raw,\n            \'NATIVE_CHANGED_DURING_SCOPE\')\n    return native, scope\n\n\ndef witness_set(answers, scope, op, tx, representatives=None):\n    require(answers.get(\'operation\') == op and answers.get(\'tx\') == tx, \'ANSWERS_IDENTITY\')\n    witnesses = answers.get(\'witnesses\')\n    require(isinstance(witnesses, list) and len(witnesses) == len(scope[\'groups\']), \'WITNESS_COVERAGE\')\n    groups = {g[\'key\']: g for g in scope[\'groups\']}; seen, names = set(), set()\n    for w in witnesses:\n        key, name = w.get(\'group_key\'), w.get(\'material_name\')\n        require(key in groups and key not in seen and w.get(\'agent\') in groups[key][\'agents\'], \'WITNESS_NATIVE_GROUP\')\n        require(isinstance(name, str) and re.fullmatch(r\'[A-Za-z0-9_-][A-Za-z0-9_.-]{0,80}\', name)\n                and name not in names and re.fullmatch(r\'[a-f0-9]{64}\', str(w.get(\'material_sha256\', \'\'))), \'WITNESS_MATERIAL\')\n        if representatives is not None:\n            expected = [r for r in representatives if r[\'group_key\'] == key]\n            require(len(expected) == 1 and all(w.get(k) == expected[0].get(k) for k in\n                (\'group_key\', \'agent\', \'channel_id\', \'main_session_id\', \'current_session_id\', \'material_name\')),\n                \'WITNESS_PROTECTED_REPRESENTATIVE\')\n        seen.add(key); names.add(name)\n    return witnesses\n\n\ndef runtime_answers(op, tx):\n    path = DRIVEN_ROOT + \'/delegations/\' + op + \'/\' + tx + \'/answers.json\'\n    raw = read_retained(path, uid=502, gid=20, limit=1048576)\n    return json.loads(raw), sha(raw), path\n\n\ndef loaded_health(auth):\n    identity = {}\n    for name, path in [(\'deployment_system.py\', SERVER), (\'ds_client.py\', CLIENT)]:\n        identity[name] = sha(read_retained(path, uid=0, gid=0, limit=128 * 1024 * 1024))\n        require(identity[name] == auth[\'artifacts\'][name], \'LOADED_IDENTITY_DRIFT\')\n    run = subprocess.run([\'/usr/bin/curl\', \'-s\', \'-m\', \'5\', \'http://127.0.0.1:8790/health\'], capture_output=True, timeout=15)\n    require(run.returncode == 0 and len(run.stdout) <= 1048576, \'HEALTH_TRANSPORT\')\n    body = json.loads(run.stdout)\n    require(body.get(\'ok\') is True and body.get(\'deliverReady\') is True, \'HEALTH_NOT_READY\')\n    return dict(loadedIdentity=identity, health=dict(ok=True, deliverReady=True))\n\n\ndef exact_message(message_id):\n    require(isinstance(message_id, str) and re.fullmatch(r\'om_[A-Za-z0-9_-]{1,128}\', message_id), \'FORMAL_MESSAGE_ID\')\n    run = subprocess.run([\'/usr/local/bin/lark-cli\', \'api\', \'GET\', \'/open-apis/im/v1/messages/\' + message_id,\n        \'--as\', \'user\', \'--format\', \'json\', \'--params\', \'{"card_msg_content_type":"user_card_content"}\'], capture_output=True, timeout=120, user=502, group=20,\n        extra_groups=[], env={\'PATH\': \'/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin\', \'LC_ALL\': \'C\', \'HOME\': \'/Users/yanfenma\'})\n    require(run.returncode == 0 and len(run.stdout) <= LIMIT, \'FORMAL_EXACT_READ_FAILED\')\n    value = json.loads(run.stdout)\n    require(type(value.get(\'code\')) is int and value[\'code\'] == 0 and isinstance((value.get(\'data\') or {}).get(\'items\'), list)\n        and len(value[\'data\'][\'items\']) == 1 and value[\'data\'][\'items\'][0].get(\'message_id\') == message_id,\n        \'FORMAL_EXACT_MESSAGE_BINDING\')\n    return value\n\n# The fixed binding/identity/reader source is inserted only after Root supplies\n# the existing legitimate source facts and D freezes its reviewed module.\n# These are deliberately fail-closed integration seams, never model authority.\ndef project_key(workspace):\n    # Existing pinned DSH projectKey, including UTF-16 code-unit escaping.\n    require(isinstance(workspace, str) and workspace and os.path.isabs(workspace)\n        and os.path.normpath(workspace) == workspace, \'WORKSPACE_PATH\')\n    units = workspace.encode(\'utf-16-be\', errors=\'surrogatepass\')\n    readable, separator = \'\', False\n    for i in range(0, len(units), 2):\n        code = int.from_bytes(units[i:i+2], \'big\'); ch = chr(code)\n        if ch in \'/\\\\:\':\n            if not separator:\n                readable += \'-\'\n            separator = True\n        elif re.fullmatch(r\'[A-Za-z0-9._-]\', ch):\n            readable += ch; separator = False\n        else:\n            readable += \'~%04X\' % code; separator = False\n    return \'--\' + (readable.lstrip(\'-\') or \'root\')[:251] + \'--\'\n\n\ndef representative_workspace(agent, row):\n    # Exact production compose/bootstrap input, not caller configuration.\n    primary = read_json(\'/Users/authsvc/.agent-core/primary-workspaces.json\',\n        uid=505, gid=601, mode=0o600, limit=1048576)\n    require(type(primary) is dict, \'PRIMARY_WORKSPACES_SHAPE\')\n    workspace_id = row.get(\'workspace\')\n    if workspace_id is not None:\n        require(isinstance(workspace_id, str) and workspace_id.strip()\n            and len(workspace_id.encode(\'utf-16-be\')) // 2 <= 200\n            and not re.search(r\'[\\x00/\\\\ .]\', workspace_id), \'BINDING_WORKSPACE_ID\')\n        return os.path.normpath(\'/Users/authsvc/.agent-core/workspaces/\' + workspace_id)\n    explicit = primary.get(agent)\n    if explicit is not None:\n        require(isinstance(explicit, str) and os.path.isabs(explicit)\n            and \'\\x00\' not in explicit, \'PRIMARY_WORKSPACE_PATH\')\n        return os.path.normpath(explicit)\n    return \'/Users/authsvc/.agent-core/workspaces/\' + agent\n\n\ndef main_session(agent, workspace):\n    require(re.fullmatch(r\'agt_[A-Za-z0-9_-]+\', agent), \'MAIN_AGENT_SCOPE\')\n    home = \'/Users/authsvc/.agent-core/homes/\' + agent\n    # Existing authorized legacy owner and service homes coexist. Derive the\n    # journal custody from this representative\'s fixed home, never a request.\n    meta = os.lstat(home)\n    require(stat.S_ISDIR(meta.st_mode) and (meta.st_uid, meta.st_gid) in ((502, 20), (505, 601))\n            and not meta.st_mode & 0o022, \'FIXED_AGENT_HOME_CUSTODY\')\n    path = home + \'/sessions/\' + project_key(workspace) + \'/main/session.jsonl\'\n    raw = read_retained(path, uid=meta.st_uid, gid=meta.st_gid, limit=4096, prefix=True)\n    header = json.loads(raw.split(b\'\\n\', 1)[0])\n    require(type(header) is dict and header.get(\'type\') == \'session\' and header.get(\'id\') == \'main\', \'CANONICAL_MAIN_HEADER\')\n    return \'main\'\n\n\ndef binding_context(scope):\n    bindings = read_json(BINDINGS_PATH, uid=505, gid=601, mode=0o644, limit=1048576)\n    require(bindings.get(\'version\') == 1 and type(bindings.get(\'bindings\')) is dict, \'BINDING_STORE_SHAPE\')\n    representatives = []\n    for group in scope[\'groups\']:\n        candidates = []\n        for key, row in bindings[\'bindings\'].items():\n            if type(row) is not dict or row.get(\'activeAgentId\') not in group[\'agents\']:\n                continue\n            # Original bridge grammar: only an existing BASE chat can use\n            # messages-send. A :topic:/:sender: binding cannot be flattened.\n            if not isinstance(key, str) or not re.fullmatch(r\'feishu:oc_[A-Za-z0-9_-]+\', key):\n                continue\n            require(row.get(\'channelConversationId\') == key and isinstance(row.get(\'activeSessionId\'), str)\n                and row[\'activeSessionId\'] and len(row[\'activeSessionId\']) <= 256, \'BINDING_ROW\')\n            candidates.append((row[\'activeAgentId\'], key, row))\n        require(candidates, \'NO_EXISTING_BASE_CHAT_REPRESENTATIVE; thread binding needs original formal reply path\')\n        agent, key, row = sorted(candidates, key=lambda c: (c[0], c[1]))[0]\n        workspace = representative_workspace(agent, row)\n        representatives.append(dict(group_key=group[\'key\'], agent=agent,\n            channel_id=key[len(\'feishu:\'):], main_session_id=main_session(agent, workspace),\n            current_session_id=row[\'activeSessionId\'],\n            material_name=sha(group[\'key\'].encode()) + \'.material\'))\n    return representatives\n\n\nNATIVE_PROOF_SOURCE = \'"""B7 original-ingress evidence verification. Internal sealed caller API, no CLI.\\n\\nscope_context, identity and reader_policy MUST originate in the privileged\\noriginal TX/holder/accepted/scope chain. This module does not mint authority.\\nNo provider call, DS action, store mutation, retry, or replay occurs here.\\n"""\\nimport datetime\\nimport hashlib\\nimport json\\nimport os\\nimport re\\nimport stat\\nimport subprocess\\nimport time\\n\\nclass NativeProofError(Exception):\\n    def __init__(self, code):\\n        self.code = code\\n        super().__init__(code)\\n\\ndef _fail(code):\\n    raise NativeProofError(code)\\n\\ndef _sha(data):\\n    return hashlib.sha256(data).hexdigest()\\n\\ndef _canonical(value):\\n    return json.dumps(value, sort_keys=True, separators=(\\\',\\\', \\\':\\\'), ensure_ascii=False).encode(\\\'utf-8\\\')\\n\\ndef _identity(st):\\n    return (st.st_dev, st.st_ino, st.st_uid, st.st_gid, stat.S_IMODE(st.st_mode), st.st_nlink, st.st_size, st.st_mtime_ns, st.st_ctime_ns)\\n\\ndef _absolute(path):\\n    if not isinstance(path, str) or not path.startswith(\\\'/\\\') or \\\'\\\\x00\\\' in path or any(part in (\\\'.\\\',\\\'..\\\',\\\'\\\') for part in path.split(\\\'/\\\')[1:]):\\n        _fail(\\\'READER_PATH\\\')\\n    return path\\n\\ndef _open_bound(path):\\n    """All path components nofollow; retain and recheck ancestor descriptors."""\\n    parts = _absolute(path).split(\\\'/\\\')[1:]\\n    held = []\\n    try:\\n        fd = os.open(\\\'/\\\', os.O_RDONLY | os.O_DIRECTORY)\\n        held.append((fd, os.fstat(fd), None, None))\\n        for name in parts[:-1]:\\n            parent = fd\\n            fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)\\n            held.append((fd, os.fstat(fd), parent, name))\\n        leaf = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)\\n        held.append((leaf, os.fstat(leaf), fd, parts[-1]))\\n        return leaf, held\\n    except Exception:\\n        for entry in reversed(held):\\n            os.close(entry[0])\\n        raise\\n\\ndef _check_bound(held, code):\\n    for fd, before, parent, name in held:\\n        # Shared ancestors may gain unrelated children; bind their inode/custody,\\n        # while the held regular leaf retains the complete metadata identity.\\n        def identity(st):\\n            return (st.st_dev,st.st_ino,st.st_uid,st.st_gid,stat.S_IMODE(st.st_mode)) if stat.S_ISDIR(st.st_mode) else _identity(st)\\n        if identity(os.fstat(fd)) != identity(before):\\n            _fail(code)\\n        if parent is not None and identity(os.stat(name, dir_fd=parent, follow_symlinks=False)) != identity(before):\\n            _fail(code)\\n\\ndef _read_fd(fd, cap):\\n    os.lseek(fd, 0, os.SEEK_SET)\\n    chunks = []; size = 0\\n    while True:\\n        chunk = os.read(fd, min(65536, cap + 1 - size))\\n        if not chunk:\\n            break\\n        chunks.append(chunk); size += len(chunk)\\n        if size > cap:\\n            _fail(\\\'READER_SIZE\\\')\\n    os.lseek(fd, 0, os.SEEK_SET)\\n    return b\\\'\\\'.join(chunks)\\n\\ndef _check_pin(pin, executable=False):\\n    fd = None; held = []\\n    try:\\n        fd, held = _open_bound(pin[\\\'path\\\']); st = os.fstat(fd)\\n        if not stat.S_ISREG(st.st_mode) or st.st_uid != pin[\\\'uid\\\'] or st.st_mode & 0o022 or st.st_nlink != 1 or (executable and not st.st_mode & 0o111):\\n            _fail(\\\'CODE_PIN_MISMATCH\\\')\\n        if _sha(_read_fd(fd, 4*1024*1024)) != pin[\\\'sha256\\\']:\\n            _fail(\\\'CODE_PIN_MISMATCH\\\')\\n        _check_bound(held, \\\'CODE_PIN_MISMATCH\\\')\\n    except NativeProofError:\\n        raise\\n    except Exception:\\n        _fail(\\\'CODE_PIN_MISMATCH\\\')\\n    finally:\\n        for entry in reversed(held): os.close(entry[0])\\n\\ndef _run_reader(fd, policy, params):\\n    payload = dict(params, storeFd=fd, readerUid=policy[\\\'store_uid\\\'], readerGid=policy[\\\'store_gid\\\'])\\n    kwargs = {}\\n    if os.geteuid() == 0:\\n        # Existing privileged-reader discipline: validation child executes as\\n        # the native-store service UID, never as root. Not exercised in UID502 tests.\\n        def drop():\\n            os.setgroups([]); os.setgid(policy[\\\'store_gid\\\']); os.setuid(policy[\\\'store_uid\\\'])\\n        kwargs[\\\'preexec_fn\\\'] = drop\\n    elif os.geteuid() != policy[\\\'store_uid\\\'] or os.getegid() != policy[\\\'store_gid\\\']:\\n        _fail(\\\'READER_IDENTITY\\\')\\n    try:\\n        run = subprocess.run([policy[\\\'node_path\\\'], \\\'--input-type=module\\\', \\\'-e\\\', JS_READER], input=_canonical(payload), capture_output=True, pass_fds=(fd,), timeout=15, env={\\\'PATH\\\':\\\'/usr/bin:/bin\\\'}, **kwargs)\\n    except Exception:\\n        _fail(\\\'NATIVE_READER_UNKNOWN\\\')\\n    if run.returncode != 0 or len(run.stdout) > 2*1024*1024:\\n        _fail(\\\'NATIVE_READER_UNKNOWN\\\')\\n    try: result = json.loads(run.stdout)\\n    except Exception: _fail(\\\'NATIVE_READER_UNKNOWN\\\')\\n    if not isinstance(result, dict) or set(result) not in ({\\\'record\\\',\\\'faithful\\\'}, {\\\'error\\\'}):\\n        _fail(\\\'NATIVE_READER_UNKNOWN\\\')\\n    if \\\'error\\\' in result:\\n        if result[\\\'error\\\'] not in (\\\'V3_VALIDATION_FAILED\\\',\\\'NATIVE_INGRESS_ABSENT\\\',\\\'NATIVE_INGRESS_AMBIGUOUS\\\',\\\'RENDERER_UNSUPPORTED\\\',\\\'READER_IDENTITY\\\',\\\'FORMAL_CONVERSATION_BINDING\\\',\\\'CARD_PROFILE_UNSUPPORTED\\\'):\\n            _fail(\\\'NATIVE_READER_UNKNOWN\\\')\\n        _fail(result[\\\'error\\\'])\\n    return result\\n\\ndef _load_record(policy, params):\\n    held = []\\n    try:\\n        pins = policy[\\\'code_pins\\\']\\n        if not isinstance(pins, (tuple,list)) or not pins: _fail(\\\'READER_POLICY\\\')\\n        nodepin = dict(path=policy[\\\'node_path\\\'], sha256=policy[\\\'node_sha256\\\'], uid=policy[\\\'node_uid\\\'])\\n        for pin in [nodepin, *pins]: _check_pin(pin, executable=(pin is nodepin))\\n        fd, held = _open_bound(policy[\\\'store_path\\\']); st = os.fstat(fd)\\n        parent = held[-2][1]\\n        if not stat.S_ISREG(st.st_mode) or st.st_uid != policy[\\\'store_uid\\\'] or st.st_gid != policy[\\\'store_gid\\\'] or stat.S_IMODE(st.st_mode) != 0o600 or st.st_nlink != 1 or not 0 < st.st_size <= 16*1024*1024:\\n            _fail(\\\'STORE_CUSTODY\\\')\\n        if parent.st_uid not in (0, policy[\\\'store_uid\\\']) or parent.st_mode & 0o022:\\n            _fail(\\\'STORE_CUSTODY\\\')\\n        before = _sha(_read_fd(fd,16*1024*1024)); _check_bound(held, \\\'STORE_CHANGED\\\')\\n        result = _run_reader(fd, policy, params)\\n        if _sha(_read_fd(fd,16*1024*1024)) != before: _fail(\\\'STORE_CHANGED\\\')\\n        _check_bound(held, \\\'STORE_CHANGED\\\')\\n        for pin in [nodepin, *pins]: _check_pin(pin, executable=(pin is nodepin))\\n        return result, before\\n    except NativeProofError: raise\\n    except Exception: _fail(\\\'STORE_CUSTODY\\\')\\n    finally:\\n        for entry in reversed(held): os.close(entry[0])\\n\\ndef _string(value, code, limit=4096):\\n    if not isinstance(value,str) or not value or \\\'\\\\x00\\\' in value or len(value.encode(\\\'utf-8\\\')) > limit:\\n        _fail(code)\\n    return value\\n\\ndef _message(response, requested):\\n    if not isinstance(response,dict) or response.get(\\\'code\\\') != 0 or not isinstance(response.get(\\\'data\\\'),dict): _fail(\\\'FORMAL_MESSAGE_SHAPE\\\')\\n    items = response[\\\'data\\\'].get(\\\'items\\\')\\n    if not isinstance(items,list) or len(items) != 1 or not isinstance(items[0],dict): _fail(\\\'FORMAL_MESSAGE_SHAPE\\\')\\n    item = items[0]\\n    if \\\'message_type\\\' in item: _fail(\\\'FORMAL_MESSAGE_TYPE_CONFLICT\\\')\\n    if not isinstance(item.get(\\\'msg_type\\\'),str) or not item[\\\'msg_type\\\']: _fail(\\\'FORMAL_MESSAGE_SHAPE\\\')\\n    if item.get(\\\'message_id\\\') != requested: _fail(\\\'FORMAL_MESSAGE_ID\\\')\\n    if item.get(\\\'deleted\\\') is True or item.get(\\\'msg_type\\\') == \\\'deleted\\\': _fail(\\\'FORMAL_MESSAGE_SHAPE\\\')\\n    return item\\n\\ndef _body(item):\\n    try:\\n        raw = _string(item[\\\'body\\\'][\\\'content\\\'], \\\'FORMAL_BODY\\\', 2*1024*1024)\\n        obj = json.loads(raw)\\n    except NativeProofError: raise\\n    except Exception: _fail(\\\'FORMAL_BODY\\\')\\n    return raw,obj\\n\\ndef _decode_reply(item, incoming_sender):\\n    raw,obj = _body(item)\\n    kind = item.get(\\\'msg_type\\\')\\n    if kind == \\\'text\\\':\\n        if not isinstance(obj,dict) or set(obj) != {\\\'text\\\'} or not isinstance(obj[\\\'text\\\'],str): _fail(\\\'RENDERER_UNSUPPORTED\\\')\\n        candidate = obj[\\\'text\\\']\\n    elif kind == \\\'post\\\':\\n        try:\\n            if set(obj) != {\\\'zh_cn\\\'} or set(obj[\\\'zh_cn\\\']) != {\\\'title\\\',\\\'content\\\'} or obj[\\\'zh_cn\\\'][\\\'title\\\'] != \\\'\\\': _fail(\\\'RENDERER_UNSUPPORTED\\\')\\n            rows = obj[\\\'zh_cn\\\'][\\\'content\\\']\\n            if len(rows) != 1 or len(rows[0]) != 1 or set(rows[0][0]) != {\\\'tag\\\',\\\'text\\\'} or rows[0][0][\\\'tag\\\'] != \\\'md\\\': _fail(\\\'RENDERER_UNSUPPORTED\\\')\\n            candidate = rows[0][0][\\\'text\\\']\\n        except NativeProofError: raise\\n        except Exception: _fail(\\\'RENDERER_UNSUPPORTED\\\')\\n    elif kind == \\\'interactive\\\':\\n        try:\\n            if not isinstance(obj,dict): _fail(\\\'RENDERER_UNSUPPORTED\\\')\\n            # Original pre-send card or the exact observed raw API metadata\\n            # profile (root receipt895fd05e). No unknown-field projection.\\n            readback=\\\'config\\\' in obj\\n            top={\\\'schema\\\',\\\'header\\\',\\\'body\\\',\\\'config\\\'} if readback else {\\\'schema\\\',\\\'header\\\',\\\'body\\\'}\\n            element_keys={\\\'tag\\\',\\\'content\\\',\\\'element_id\\\'} if readback else {\\\'tag\\\',\\\'content\\\'}\\n            if set(obj)!=top or obj[\\\'schema\\\']!=\\\'2.0\\\' or set(obj[\\\'header\\\'])!={\\\'title\\\'} or set(obj[\\\'header\\\'][\\\'title\\\'])!={\\\'tag\\\',\\\'content\\\'} or obj[\\\'header\\\'][\\\'title\\\'][\\\'tag\\\']!=\\\'plain_text\\\' or set(obj[\\\'body\\\'])!={\\\'elements\\\'}: _fail(\\\'RENDERER_UNSUPPORTED\\\')\\n            elements=obj[\\\'body\\\'][\\\'elements\\\']\\n            if not i