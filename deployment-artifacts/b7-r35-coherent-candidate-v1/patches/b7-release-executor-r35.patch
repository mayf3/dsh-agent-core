 \'botOpenId\': \'ou_1e1d5284ff846084bb78fce0aa11c083\'}\n\ndef native_proof(context, witness, material_bytes):\n    # D is a byte-pinned sealed literal, never a writable file import.\n    require(sha(NATIVE_PROOF_SOURCE.encode()) == NATIVE_PROOF_SOURCE_SHA256, \'PROOF_LITERAL_PIN\')\n    namespace = dict(__name__=\'b7_sealed_native_proof\')\n    exec(compile(NATIVE_PROOF_SOURCE, \'<sealed-native-proof>\', \'exec\'), namespace)\n    incoming_id, reply_id = witness.get(\'request_message_id\'), witness.get(\'pong_message_id\')\n    exchange = dict(incoming_message_id=incoming_id, reply_message_id=reply_id,\n        nonce=witness.get(\'nonce\'), incoming_response=exact_message(incoming_id),\n        reply_response=exact_message(reply_id))\n    require(exchange[\'incoming_response\'][\'data\'][\'items\'][0].get(\'chat_id\') == witness[\'channel_id\'],\n            \'PROTECTED_BINDING_CHAT\')\n    proof = namespace[\'load_verify\'](context, exchange, TRUSTED_IDENTITY,\n        reader_policy=READER_POLICY, material_bytes=material_bytes)\n    # These are the exact formal IDs already checked by the native verifier.\n    return dict(proof, incomingMessageId=incoming_id, replyMessageId=reply_id)\n\n\ndef proof_facts(auth, driven, op, tx, sequence, stage, group_key=None, source=None):\n    require(op in (auth.get(\'inScopeOperations\') or []), \'OP_OUT_OF_SCOPE\')\n    require(type(sequence) is int and sequence >= 0, \'SEQUENCE_SHAPE\')\n    status = current_status(op, tx, sequence)\n    native, scope = native_scope(driven, tx)\n    if stage == \'context\':\n        require(group_key is None, \'CONTEXT_GROUP\')\n        representatives = binding_context(scope)\n        initial_facts = loaded_health(auth)\n        require(current_status(op, tx, sequence) == status, \'STATUS_CHANGED_DURING_CONTEXT\')\n        return dict(kind=\'B7_CONTEXT_V1\', operationId=op, txId=tx, sequence=sequence,\n            holderNonce=native[\'outer\'][\'nonce\'], scope=scope, representatives=representatives,\n            **initial_facts)\n    answers, answers_sha, answers_path = runtime_answers(op, tx)\n    representatives = binding_context(scope)\n    witnesses = witness_set(answers, scope, op, tx, representatives)\n    # Reuse the original act\'s root-derived initial freshness cutoff after it\n    # exists; never replace it by a successor timestamp or caller assertion.\n    cutoff = stamp_ns(native.get(\'updatedAt\'))\n    act_path = MIGRATION + \'/b7-delegation-act.json\'\n    if stage not in (\'bind\', \'place\'):\n        act = read_json(act_path, mode=0o600)\n        require(act.get(\'kind\') == \'B7_DELEGATED_ACT_RECEIPT_V1\'\n            and act.get(\'approvalRef\') == \'OWNER-B7-RELEASE-20261016-01\'\n            and act.get(\'operationId\') == op and act.get(\'txId\') == tx\n            and act.get(\'holderNonce\') == native[\'outer\'][\'nonce\']\n            and act.get(\'serverSha256\') == auth[\'artifacts\'][\'deployment_system.py\']\n            and act.get(\'clientSha256\') == auth[\'artifacts\'][\'ds_client.py\']\n            and act.get(\'clauseSha256\') == auth.get(\'delegationClauseSha256\')\n            and act.get(\'inScopeOperations\') == auth.get(\'inScopeOperations\')\n            and act.get(\'manifestSha256\') == (auth.get(\'frozen_candidate\') or {}).get(\'packet_manifest_sha256\')\n            and act.get(\'gates\', {}).get(\'answersSha256\') == answers_sha, \'CURRENT_ACT_IDENTITY\')\n        initial = act.get(\'gates\', {}).get(\'nativeContext\') or {}\n        require(initial.get(\'scope\') == scope and initial.get(\'holderNonce\') == native[\'outer\'][\'nonce\']\n            and type(initial.get(\'txUpdatedAtNs\')) is int, \'CURRENT_ACT_NATIVE_CONTEXT\')\n        cutoff = initial[\'txUpdatedAtNs\']\n    context = dict(operationId=op, txId=tx, holderNonce=native[\'outer\'][\'nonce\'],\n        txUpdatedAtNs=cutoff, scope=scope, mainSessions={r[\'agent\']: r[\'main_session_id\'] for r in representatives})\n    proofs, materials, total = [], [], 0\n    for w in witnesses:\n        expected_source = DRIVEN_ROOT + \'/delegations/\' + op + \'/\' + tx + \'/\' + sha(w[\'group_key\'].encode()) + \'/\' + w[\'material_name\']\n        require(w.get(\'source_path\') == expected_source, \'FIXED_SOURCE_SCOPE\')\n        path = expected_source if stage == \'place\' else MIGRATION + \'/owner-materials-\' + tx + \'/\' + w[\'material_name\']\n        raw = read_retained(path, uid=502 if stage == \'place\' else 0,\n            gid=20 if stage == \'place\' else 0, mode=None if stage == \'place\' else 0o600)\n        total += len(raw)\n        require(total <= 22 * 1024 * 1024, \'ORIGINAL_TOTAL_MATERIAL_SIZE\')\n        require(sha(raw) == w[\'material_sha256\'], \'MATERIAL_ACTUAL_DIGEST\')\n        proof = native_proof(context, w, raw)\n        require(proof[\'agentId\'] == w[\'agent\'] and proof[\'groupKey\'] == w[\'group_key\']\n            and proof[\'sessionId\'] == w[\'current_session_id\']\n            and proof[\'materialSha256\'] == w[\'material_sha256\'], \'NATIVE_WITNESS_BINDING\')\n        proofs.append(proof)\n        materials.append(dict(groupKey=w[\'group_key\'], agent=w[\'agent\'], materialName=w[\'material_name\'], materialSha256=sha(raw)))\n    if stage == \'place\':\n        selected = [w for w in witnesses if w[\'source_path\'] == source]\n        require(len(selected) == 1, \'PLACEMENT_FIXED_WITNESS_SOURCE\')\n        return dict(operationId=op, txId=tx, materialName=selected[0][\'material_name\'], materialSha256=selected[0][\'material_sha256\'])\n    mdir = MIGRATION + \'/owner-materials-\' + tx\n    expected_placed = {(m[\'materialName\'], m[\'materialSha256\']) for m in materials}\n    placed = set()\n    for name in os.listdir(mdir):\n        require(re.fullmatch(r\'[A-Za-z0-9_-][A-Za-z0-9_.-]{0,80}\', name), \'PLACED_FOREIGN_NAME\')\n        placed.add((name, sha(read_retained(mdir + \'/\' + name, uid=0, gid=0, mode=0o600))))\n    require(placed == expected_placed, \'PLACED_SET_MISMATCH\')\n    if stage not in (\'bind\', \'place\'):\n        require(act[\'gates\'][\'materials\'] == materials, \'CURRENT_ACT_MATERIALS\')\n        # Fresh store snapshots and proof time may advance, but this same ACT\n        # cannot silently switch native executions, messages, or output proof.\n        def core(proof):\n            return {key: value for key, value in proof.items() if key not in (\'proofAtNs\', \'storeSha256\')}\n        retained = act[\'gates\'].get(\'native_proof\')\n        require(isinstance(retained, list) and len(retained) == len(proofs)\n            and [core(p) for p in retained] == [core(p) for p in proofs], \'CURRENT_ACT_NATIVE_PROOF\')\n    facts = loaded_health(auth)\n    require(stage in (\'bind\', \'commit\', \'witnessed\', \'confirm\'), \'TERMINAL_STAGE\')\n    require(group_key is None if stage != \'witnessed\' else group_key in {w[\'group_key\'] for w in witnesses}, \'TERMINAL_GROUP\')\n    # Reread STATUS after external verification, immediately before returning\n    # a fact set to the shell\'s durable receipt and terminal caller.\n    require(current_status(op, tx, sequence) == status, \'STATUS_CHANGED_DURING_GATES\')\n    facts.update(operationId=op, txId=tx, stage=stage, sequence=sequence, groupKey=group_key,\n        status=dict(phase=\'RUNNING\', active=True, attempt=1, input_sequence=sequence,\n            input_pending=False, reason=\'EXECUTION_INTENT\'),\n        nativeContext=context, native_proof=proofs, materials=materials,\n        answersSha256=answers_sha, verifiedAtNs=time.time_ns())\n    return facts\n\n\ndef actor_start_digest(path, op, tx, staged):\n    raw = read_retained(path, uid=0, gid=0, mode=0o644, limit=65536, tail=True)\n    row = json.loads(raw)\n    require(row.get(\'approval_ref\') == \'OWNER-B7-RELEASE-20261016-01\'\n        and row.get(\'operation\') == \'bind-act\' and row.get(\'outcome\') == \'STARTED\'\n        and row.get(\'detail\') == \'op=bind-act args=\' + op + \'|\' + tx + \'|\' + staged,\n