n fields from the actual card.\\\\n   expectedCard.config={enable_forward_interaction:false,streaming_mode:false};\\\\n   expectedCard.body.elements[0].element_id=r.body.body.elements[0].element_id;\\\\n  }\\\\n  faithful=calls===1 && captured?.path?.message_id===incoming.message_id && captured?.data?.msg_type===\\\\\\\'interactive\\\\\\\' && captured?.data?.reply_in_thread===(conv.channel===\\\\\\\'thread\\\\\\\') && JSON.stringify(canonical(expectedCard))===JSON.stringify(canonical(r.body));\\\\n } else throw new Error(\\\\\\\'RENDERER_UNSUPPORTED\\\\\\\');\\\\n if(r.candidateText.length>3500)faithful=false;\\\\n process.stdout.write(JSON.stringify({record:matches[0],faithful}));\\\\n} catch(error) {\\\\n const code=[\\\\\\\'V3_VALIDATION_FAILED\\\\\\\',\\\\\\\'NATIVE_INGRESS_ABSENT\\\\\\\',\\\\\\\'NATIVE_INGRESS_AMBIGUOUS\\\\\\\',\\\\\\\'RENDERER_UNSUPPORTED\\\\\\\',\\\\\\\'READER_IDENTITY\\\\\\\',\\\\\\\'FORMAL_CONVERSATION_BINDING\\\\\\\',\\\\\\\'CARD_PROFILE_UNSUPPORTED\\\\\\\'].includes(error.message)?error.message:\\\\\\\'V3_VALIDATION_FAILED\\\\\\\';\\\\n process.stdout.write(JSON.stringify({error:code}));\\\\n}\\\\n\\\'\\n\'\nNATIVE_PROOF_SOURCE_SHA256 = \'8efb0267081c885db5b528a27df7474f6e36dd303dea1abb791052b9ce0c388c\'\nREADER_POLICY = {\'store_path\': \'/Users/authsvc/.agent-core/control/turn-recovery-v3.json\', \'store_uid\': 505, \'store_gid\': 601, \'node_path\': \'/usr/local/libexec/agent-core/node-runtime/bin/node\', \'node_sha256\': \'c6c9bfa8eb5d0c6799e1fd7e246f5c6036d4863b5d3173625f37d952576ca93b\', \'node_uid\': 0, \'code_pins\': [{\'path\': \'/usr/local/libexec/agent-core/app/packages/agent-router/src/reconciliation/durable-file.js\', \'sha256\': \'44120e2bc94c7b6941029ecf08eadde49dec4356bb7e9fb71d64849699fd5d26\', \'uid\': 505}, {\'path\': \'/usr/local/libexec/agent-core/app/packages/agent-router/src/reconciliation/capacity.js\', \'sha256\': \'237afe154801a0900209e68ddae47f1d7e0ca531594729209f16f687c73bb8b0\', \'uid\': 505}, {\'path\': \'/us