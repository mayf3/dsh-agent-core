    def test_output_uses_original_identity_path(self):
        self.success(self.fx.request(DISPOSE))
        before = list(self.fx.writes)
        data = self.success(self.fx.request("DS_B7_OWNER_OUTPUT_V2", cursor=0))
        self.assertEqual(data["output_b64"], "")
        self.assertEqual(self.fx.writes, before)

    def test_closed_operation_cannot_execute_or_replay(self):
        self.success(self.fx.request(DISPOSE))
        self.refused("B7_PACKET_EXECUTE_V2", "NONTERMINAL")

    def test_other_operation_old_policy_remains_rejected(self):
        foreign = "b7-packet-foreign-e99"
        record = dict(self.fx.reg, operation_id=foreign)
        self.fx.put(Path(self.fx.ds.receipt_path(foreign)), canonical(record), 0o644)
        self.refused(STATUS, "BINDING_MISMATCH", op=foreign)

    def test_other_current_operation_remains_readable_without_closure(self):
        foreign = "b7-packet-current-e99"
        row = self.fx.registration.policy["packets"][PACKET]
        identity = dict(operation_id=foreign, binding=dict(packetId=PACKET,
            manifestSha256=row["manifestSha256"], sourceSha256=row["sourceSha256"]),
            registered_peer_uid=502, policy_sha256=self.fx.registration.policy_sha)
        record = dict(kind="DS_B7_PACKET_REGISTRATION_V1", version=1,
            action="B7_PACKET_REGISTER_V1", state="REGISTERED_ONLY", **identity,
            request_sha256=sha(canonical(identity)))
        self.fx.put(Path(self.fx.ds.receipt_path(foreign)), canonical(record), 0o644)
        data = self.success(self.fx.request(STATUS, op=foreign))
        self.assertEqual(data["phase"], "NO_EXECUTION_RECORD")
        self.assertNotIn("disposal_terminal", data)
        self.assertEqual(self.fx.writes, [])

    def test_other_operation_cannot_adopt_e29_execution_policy_exception(self):
        foreign = "b7-packet-current-e99"
        row = self.fx.registration.policy["packets"][PACKET]
        identity = dict(operation_id=foreign, binding=dict(packetId=PACKET,
            manifestSha256=row["manifestSha256"], sourceSha256=row["sourceSha256"]),
            registered_peer_uid=502, policy_sha256=self.fx.registration.policy_sha)
        record = dict(kind="DS_B7_PACKET_REGISTRATION_V1", version=1,
            action="B7_PACKET_REGISTER_V1", state="REGISTERED_ONLY", **identity,
            request_sha256=sha(canonical(identity)))
        self.fx.put(Path(self.fx.ds.receipt_path(foreign)), canonical(record), 0o644)
        execution = dict(self.fx.state, operation_id=foreign,
            registration_sha256=record["request_sha256"],
            execution_policy_sha256=OLD_EXEC_POLICY)
        target = Path(self.fx.ds.receipt_path(foreign)).with_name(foreign + ".b7-execution.json")
        self.fx.put(target, canonical(execution), 0o600)
        self.refused(STATUS, "BINDING_MISMATCH", op=foreign)

    def test_original_admission_rejects_extra_request_fields(self):
        self.refused(DISPOSE, "INVALID_REQUEST", invented="field")

    def test_new_registration_keeps_current_candidate_checks(self):
        self.refused("B7_PACKET_REGISTER_V1", "BINDING_MISMATCH", packet_id=PACKET,
                     manifest_sha256=MANIFEST, source_sha256=SOURCE)

    def test_current_registration_cannot_overwrite_e29_historical_receipt(self):
        row = self.fx.registration.policy["packets"][PACKET]
        self.refused("B7_PACKET_REGISTER_V1", "BINDING_MISMATCH", packet_id=PACKET,
                     manifest_sha256=row["manifestSha256"], source_sha256=row["sourceSha256"])
        self.assertEqual(self.fx.reg_path.read_bytes(), self.fx.reg_raw)

    def test_actual_paired_client_accepts_e29_closure_response(self):
        self.closed(self.success(self.fx.client_request(DISPOSE)))

    def test_actual_paired_client_status_preserves_verified_e29_terminal(self):
        self.closed(self.success(self.fx.request(DISPOSE)))
        before = self.fx.snapshot()
        self.closed(self.success(self.fx.client_request(STATUS)))
        self.assertEqual(self.fx.snapshot(), before)

    def test_actual_paired_client_status_cli_consumes_real_status_route(self):
        self.success(self.fx.request(DISPOSE))
        self.success(self.fx.client_request(STATUS))  # Loads actual client + CLI hooks.
        output = io.StringIO()
        with patch.object(sys, "argv", [str(CLIENT), "b7-status-r3", OP]):
            with contextlib.redirect_stdout(output), self.assertRaises(SystemExit) as exited:
                self.fx.client.main()
        self.assertEqual(exited.exception.code, 0)
        self.closed(self.success(json.loads(output.getvalue())))

    def test_actual_paired_client_rejects_closed_projection_outside_retained_null_tx(self):
        self.success(self.fx.request(DISPOSE))
        for changes in ({"phase": "RUNNING"}, {"tx_id": "tx-foreign"}):
            with self.subTest(changes=changes):
                def transform(response):
                    response["data"].update(changes)
                    return response
                self.fx.response_transform = transform
                result = self.fx.client_request(STATUS)
                self.assertFalse(result["ok"], result)
                self.assertEqual(result["error"]["code"], "INVALID_RESPONSE")

    def test_actual_paired_client_rejects_closed_projection_for_foreign_subject(self):
        verified = self.fx.request(DISPOSE)
        self.success(verified)
        foreign = "b7-packet-foreign-e99"
        def foreign_projection(_):
            response = copy.deepcopy(verified)
            response.update(action=STATUS, operation_id=foreign, effect="READ_ONLY")
            return response
        self.fx.response_transform = foreign_projection
        result = self.fx.client_request(STATUS, op=foreign)
        self.assertFalse(result["ok"], result)
        self.assertEqual(result["error"]["code"], "INVALID_RESPONSE")

    def test_actual_paired_client_rejects_forged_installation_claim(self):
        self.success(self.fx.request(DISPOSE))
        def transform(response):
            response["data"]["disposal_terminal"]["installed"] = True
            return response
        self.fx.response_transform = transform
        result = self.fx.client_request(STATUS)
        self.assertFalse(result["ok"], result)
        self.assertEqual(result["error"]["code"], "INVALID_RESPONSE")

    def missing_disposal_projection_field(self, field):
        def transform(response):
            response["data"].pop(field)
            return response
        self.fx.response_transform = transform
        try:
            result = self.fx.client_request(DISPOSE)
        except KeyError as exc:
            self.fail(f"paired disposal projection leaked KeyError for missing {field}: {exc}")
        self.assertFalse(result["ok"], result)
        self.assertEqual(result["error"]["code"], "INVALID_RESPONSE")

    def test_actual_paired_disposal_response_missing_tx_id_is_invalid_response(self):
        self.missing_disposal_projection_field("tx_id")

    def test_actual_paired_disposal_response_missing_next_action_is_invalid_response(self):
        self.missing_disposal_projection_field("next_action")


if __name__ == "__main__":
    CANDIDATE = Candidate()
    print("candidate_server_sha256=" + CANDIDATE.sha256, flush=True)
    print("candidate_client_sha256=" + CANDIDATE.client_sha256, flush=True)
    program = unittest.main(verbosity=2, exit=False)
    result = program.result
    evidence = WB / "codex-takeover-20261016/e29-test-latest.json"
    evidence.parent.mkdir(exist_ok=True)
    evidence.write_text(json.dumps(dict(
        kind="E29_REAL_WIRING_ISOLATED_TESTS_V1",
        candidate_server_sha256=CANDIDATE.sha256,
        candidate_client_sha256=CANDIDATE.client_sha256,
        test_source_sha256=sha(Path(__file__).read_bytes()),
        tests_run=result.testsRun, failures=len(result.failures), errors=len(result.errors),
        successful=result.wasSuccessful(), requests=RESULTS,
        limits=["isolated I/O adapter models root custody; modes/bytes/flock are real",
                "not production load or implementation-independent review PASS",
                "e23 behavior regression remains separate"],
    ), indent=2) + "\n")
    raise SystemExit(0 if result.wasSuccessful() else 1)
