{
  "$comment": [
    "Golden vectors GV1-GV6 — AGENT_CORE_LARK_CHANNEL_SDK_INTEGRATION_V1 §7.1 (frozen).",
    "Each `input` is a raw im.message.receive_v1 wire event in the shape the Lark",
    "node-sdk EventDispatcher hands to handlers (v2 events are flattened by",
    "RequestHandle.parse: header fields hoisted to top level, event body's",
    "sender/message kept nested) — exactly what @larksuite/channel's builtin",
    "message handler (and therefore its normalize()) receives in production.",
    "Chain under test, per vector: raw wire event -> pinned @larksuite/channel",
    "normalize() -> thin adapter normalizedToIngressEvent() -> conversationId,",
    "then router.channelConversationId('feishu', conversationId) -> ccId.",
    "Expected values are byte-frozen; any drift fails the suite."
  ],
  "botIdentity": {
    "openId": "ou_bot_self",
    "name": "my-bot"
  },
  "vectors": [
    {
      "id": "GV1",
      "describe": "p2p baseline: conversationId = chatId",
      "input": {
        "schema": "2.0",
        "event_id": "evt_gv1_p2p",
        "event_type": "im.message.receive_v1",
        "create_time": "1712000000000",
        "token": "x",
        "app_id": "cli_test",
        "tenant_key": "tenant_x",
        "sender": {
          "sender_id": {
            "open_id": "ou_sender_gv1",
            "union_id": "on_sender_gv1",
            "user_id": "u_sender_gv1"
          },
          "sender_type": "user",
          "tenant_key": "tenant_x"
        },
        "message": {
          "message_id": "om_gv1_msg_001",
          "create_time": "1712000000000",
          "chat_id": "oc_4d2f81a9e7",
          "chat_type": "p2p",
          "message_type": "text",
          "content": "{\"text\":\"hello from p2p\"}",
          "mentions": []
        }
      },
      "expected": {
        "conversationId": "oc_4d2f81a9e7",
        "ccId": "feishu:oc_4d2f81a9e7",
        "channel": "p2p",
        "chatType": "p2p",
        "threadId": null,
        "rootMsgId": null,
        "replyInThread": false,
        "chatId": "oc_4d2f81a9e7"
      }
    },
